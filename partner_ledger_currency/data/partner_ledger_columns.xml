<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Adds a small "Currency" column to the standard Partner Ledger,
        immediately before the existing "Amount Currency" column, so a reader
        can tell whether a figure is USD or IQD.

        Standard sequences in Odoo 19:
            20 journal_code | 30 account_code | 40 invoice_date
            50 date_maturity | 60 matching_number | 70 debit | 80 credit
            90 amount_currency | 100 balance

        We use 85 to land between Credit and Amount Currency.

        SAFE TO REMOVE: if this column ever causes trouble, delete this file
        from __manifest__.py and upgrade the module. Filling in the Amount
        Currency figures (the other half of this module) does not depend on it.
    -->

    <record id="partner_ledger_column_currency" model="account.report.column">
        <field name="report_id" ref="account_reports.partner_ledger_report"/>
        <field name="name">Currency</field>
        <field name="expression_label">currency_name</field>
        <field name="sequence">85</field>
        <field name="figure_type">string</field>
    </record>

</odoo>
