<template id="from_lines">

    <t t-call="web.html_container">

        <style>
            .page {
                font-size: 8px;
                line-height: 1.15;
                width: 100%;
                max-width: 100%;
                overflow: hidden;
            }

            .statement-title {
                font-size: 16px;
                margin: 0 0 8px 0;
            }

            .statement-info {
                font-size: 8px;
                margin-bottom: 8px;
                width: 100%;
            }

            .statement-info .col-3 {
                padding-left: 4px;
                padding-right: 4px;
            }


            /* ==========================================
            MAIN TABLE
            ========================================== */

            .statement-table {
                width: 98% !important;
                max-width: 98% !important;
                min-width: 0 !important;

                table-layout: fixed !important;
                border-collapse: collapse !important;

                font-size: 6.5px !important;
                line-height: 1.05;

                margin: 0 0 8px 0 !important;

                overflow: hidden;
            }


            .statement-table th,
            .statement-table td {
                box-sizing: border-box !important;

                min-width: 0 !important;
                max-width: 100% !important;

                padding: 2px !important;

                vertical-align: middle;

                overflow: hidden !important;

                word-wrap: break-word !important;
                overflow-wrap: anywhere !important;

                white-space: normal !important;
            }


            .statement-table thead th {
                font-size: 6.5px !important;
                font-weight: bold;

                white-space: normal !important;

                word-break: break-word !important;
                overflow-wrap: anywhere !important;
            }


            .statement-table td {
                font-size: 6.5px !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;

                white-space: normal !important;
            }


            /* ==========================================
            FIXED COLUMNS
            مجموعها = 100%
            ========================================== */

            .statement-table col.col-date {
                width: 7% !important;
            }

            .statement-table col.col-trans {
                width: 13% !important;
            }

            .statement-table col.col-desc {
                width: 24% !important;
            }

            .statement-table col.col-qty {
                width: 8% !important;
            }

            .statement-table col.col-price {
                width: 10% !important;
            }

            .statement-table col.col-debit {
                width: 13% !important;
            }

            .statement-table col.col-credit {
                width: 13% !important;
            }

            .statement-table col.col-balance {
                width: 12% !important;
            }


            /* ==========================================
            NUMERIC COLUMNS
            ========================================== */

            .statement-table th.text-end,
            .statement-table td.text-end {
                text-align: right !important;

                font-size: 6px !important;

                min-width: 0 !important;
                max-width: 100% !important;

                white-space: normal !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;
            }


            /* ==========================================
            BALANCE - FORCE IT TO STAY INSIDE
            ========================================== */

            .statement-table td:last-child,
            .statement-table th:last-child {
                width: 12% !important;
                max-width: 12% !important;
                min-width: 0 !important;

                overflow: hidden !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;

                white-space: normal !important;
            }


            .statement-table td:last-child strong {
                display: block !important;

                max-width: 100% !important;
                width: 100% !important;

                overflow: hidden !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;
            }


            /* ==========================================
            TRANSACTION
            ========================================== */

            .statement-table td:nth-child(2) {
                word-break: break-all !important;
                overflow-wrap: anywhere !important;
            }


            /* ==========================================
            DESCRIPTION
            ========================================== */

            .statement-table td:nth-child(3) {
                word-break: break-word !important;
                overflow-wrap: anywhere !important;
            }


            /* ==========================================
            TOTAL
            ========================================== */

            .statement-total {
                width: 98% !important;
                max-width: 98% !important;

                font-size: 7px;

                margin-top: 5px;
                margin-bottom: 10px;

                page-break-inside: avoid;
            }


            .statement-total table {
                width: 100% !important;
                max-width: 100% !important;

                table-layout: fixed !important;

                border-collapse: collapse !important;
            }


            .statement-total th,
            .statement-total td {
                box-sizing: border-box !important;

                padding: 3px !important;

                font-weight: bold;
                font-size: 7px;

                min-width: 0 !important;
                max-width: 100% !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;
            }


            /* ==========================================
            BALANCE SECTION
            ========================================== */

            .statement-balance {
                width: 98%;

                font-size: 8px;

                margin-top: 8px;

                page-break-inside: avoid;
            }


            .statement-signature {
                width: 98%;

                font-size: 8px;

                margin-top: 12px;

                page-break-inside: avoid;
            }


            .statement-signature .col-6 {
                padding-left: 5px;
                padding-right: 5px;
            }

        </style>

        <!-- ==========================================
             LOOP THROUGH STATEMENTS
             ========================================== -->

        <t t-foreach="statements" t-as="stmt_data">


            <t t-call="web.external_layout">


                <div class="page">


                    <!-- ==========================
                         Report Title
                         ========================== -->

                    <h2 class="text-center statement-title">

                        Customer Statement Report

                    </h2>


                    <!-- ==========================
                         Statement Information
                         ========================== -->

                    <div class="row statement-info">


                        <div class="col-3">

                            <strong>Partner Name:</strong>

                            <span t-esc="stmt_data['partner'].name"/>

                        </div>


                        <div class="col-3">

                            <strong>Initial Balance:</strong>

                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['opening_balance']
                                )"/>

                            </span>

                            IQD

                        </div>


                        <div class="col-3">

                            <strong>From:</strong>

                            <span t-esc="date_from"/>

                        </div>


                        <div class="col-3">

                            <strong>To:</strong>

                            <span t-esc="date_to"/>

                        </div>


                    </div>


                    <!-- ==========================
                         Statement Lines
                         ========================== -->

                    <table
                        class="table table-sm table-bordered statement-table"
                        style="width: 98% !important; max-width: 98% !important; table-layout: fixed !important;"
                    >

                        <colgroup>

                            <col style="width: 7% !important;"/>
                            <col style="width: 13% !important;"/>
                            <col style="width: 24% !important;"/>
                            <col style="width: 8% !important;"/>
                            <col style="width: 10% !important;"/>
                            <col style="width: 13% !important;"/>
                            <col style="width: 13% !important;"/>
                            <col style="width: 12% !important;"/>

                        </colgroup>


                        <thead>

                            <tr>

                                <th>
                                    Date
                                </th>


                                <th>
                                    Transaction
                                </th>


                                <th>
                                    Product / Description
                                </th>


                                <th class="text-end">
                                    Quantity
                                </th>


                                <th class="text-end">
                                    Unit Price
                                </th>


                                <th class="text-end">
                                    Debit
                                </th>


                                <th class="text-end">
                                    Credit
                                </th>


                                <th class="text-end">
                                    Balance
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            <t t-foreach="stmt_data['lines']" t-as="line">


                                <tr>


                                    <!-- ==========================
                                         Date
                                         ========================== -->

                                    <td>

                                        <span t-esc="line['date']"/>

                                    </td>


                                    <!-- ==========================
                                         Transaction
                                         ========================== -->

                                    <td>

                                        <span t-esc="line['transaction']"/>

                                    </td>


                                    <!-- ==========================
                                         Product / Description
                                         ========================== -->

                                    <td style="white-space: pre-line;">

                                        <span t-esc="line['product']"/>

                                    </td>


                                    <!-- ==========================
                                         Quantity
                                         ========================== -->

                                    <td class="text-end">

                                        <t t-if="line['quantity'] is not None">

                                            <span>

                                                <t t-esc="'{:,.3f}'.format(
                                                    line['quantity']
                                                )"/>

                                            </span>

                                        </t>

                                    </td>


                                    <!-- ==========================
                                         Unit Price
                                         ========================== -->

                                    <td class="text-end">

                                        <t t-if="line['unit_price'] is not None">

                                            <span>

                                                <t t-esc="'{:,.2f}'.format(
                                                    line['unit_price']
                                                )"/>

                                            </span>

                                        </t>

                                    </td>


                                    <!-- ==========================
                                         Debit
                                         ========================== -->

                                    <td class="text-end">

                                        <span>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['debit']
                                            )"/>

                                        </span>

                                    </td>


                                    <!-- ==========================
                                         Credit
                                         ========================== -->

                                    <td class="text-end">

                                        <span>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['credit']
                                            )"/>

                                        </span>

                                    </td>


                                    <!-- ==========================
                                         Balance
                                         ========================== -->

                                    <td class="text-end">

                                        <strong>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['balance']
                                            )"/>

                                        </strong>

                                    </td>


                                </tr>


                            </t>


                        </tbody>


                    </table>


                    <!-- ==========================
                         GLOBAL TOTAL
                         ========================== -->

                    <div class="statement-total">


                        <table class="table table-sm table-bordered">


                            <!-- Fixed widths for total table -->

                            <colgroup>

                                <col style="width: 7%;"/>

                                <col style="width: 12%;"/>

                                <col style="width: 25%;"/>

                                <col style="width: 8%;"/>

                                <col style="width: 10%;"/>

                                <col style="width: 13%;"/>

                                <col style="width: 13%;"/>

                                <col style="width: 12%;"/>

                            </colgroup>


                            <tbody>

                                <tr>


                                    <!-- ==========================
                                         Total Label
                                         ========================== -->

                                    <th colspan="3">

                                        Total

                                    </th>


                                    <!-- ==========================
                                         Total Quantity
                                         ========================== -->

                                    <th class="text-end">

                                        <t t-esc="'{:,.3f}'.format(
                                            stmt_data['total_qty']
                                        )"/>

                                    </th>


                                    <!-- ==========================
                                         Empty Unit Price
                                         ========================== -->

                                    <th>
                                    </th>


                                    <!-- ==========================
                                         Total Debit
                                         ========================== -->

                                    <th class="text-end">

                                        <t t-esc="'{:,.2f}'.format(
                                            stmt_data['total_debit']
                                        )"/>

                                    </th>


                                    <!-- ==========================
                                         Total Credit
                                         ========================== -->

                                    <th class="text-end">

                                        <t t-esc="'{:,.2f}'.format(
                                            stmt_data['total_credit']
                                        )"/>

                                    </th>


                                    <!-- ==========================
                                         Closing Balance
                                         ========================== -->

                                    <th class="text-end">

                                        <t t-esc="'{:,.2f}'.format(
                                            stmt_data['closing_balance']
                                        )"/>

                                    </th>


                                </tr>

                            </tbody>


                        </table>


                    </div>


                    <!-- ==========================
                         Final Balance
                         ========================== -->

                    <div class="row statement-balance">


                        <div class="col-6">


                            <strong>

                                Current Balance:

                            </strong>


                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>

                            </span>

                            IQD


                        </div>


                        <div class="col-6">


                            <strong>

                                Final Account Balance:

                            </strong>


                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>

                            </span>

                            IQD


                        </div>


                    </div>


                    <!-- ==========================
                         Accountant Signature
                         ========================== -->

                    <div class="row statement-signature">


                        <div class="col-6">


                            <strong>

                                Accountant Name:

                            </strong>


                            __________________________________


                        </div>


                        <div class="col-6">


                            <strong>

                                Accountant Signature:

                            </strong>


                            __________________________________


                        </div>


                    </div>


                </div>


            </t>


            <!-- ==========================
                 Separate Statements
                 ========================== -->

            <t t-if="not stmt_data_last">

                <div style="page-break-after: always;"></div>

            </t>


        </t>


    </t>

</template>





    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Customer Statement Report (Balance)</h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="wizard.partner_id.name"/>
                        </div>
                        <div class="col-3">
                            <strong>Initial Balance:</strong>
                            <span t-esc="'%.2f' % stmt['opening_balance']"/> IQD
                        </div>
                        <div class="col-3">
                            <strong>From:</strong>
                            <span t-esc="wizard.date_from"/>
                        </div>
                        <div class="col-3">
                            <strong>To:</strong>
                            <span t-esc="wizard.date_to"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="stmt['lines']" t-as="line">
                                <td t-esc="line['date']"/>
                                <td t-esc="line['transaction']"/>
                                <td t-esc="line['product']"/>
                                <td t-esc="line['quantity']"/>
                                <td t-esc="'%.2f' % line['unit_price']"/>
                                <td t-esc="'%.2f' % line['debit']"/>
                                <td t-esc="'%.2f' % line['credit']"/>
                                <td t-esc="'%.2f' % line['balance']"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="text-end mt-3">
                        <strong>Closing Balance: </strong>
                        <span t-esc="'%.2f' % stmt['closing_balance']"/> IQD
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>