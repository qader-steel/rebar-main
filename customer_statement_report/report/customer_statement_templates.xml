<template id="from_lines">

    <t t-call="web.html_container">

        <t t-foreach="statements" t-as="stmt_data">

            <t t-call="web.external_layout">

                <div class="page"
                     style="
                        width:100%;
                        font-size:8pt;
                        line-height:1.15;
                        box-sizing:border-box;
                        overflow:hidden;
                     ">

                    <!-- =====================================================
                         TITLE
                         ===================================================== -->

                    <h2 class="text-center"
                        style="
                            font-size:14pt;
                            line-height:1.15;
                            margin:0 0 8px 0;
                            padding:0;
                            font-weight:bold;
                        ">
                        Customer Statement Report
                    </h2>


                    <!-- =====================================================
                         STATEMENT INFORMATION
                         ===================================================== -->

                    <div class="row"
                         style="
                            width:100%;
                            margin:0 0 8px 0;
                            font-size:8pt;
                            line-height:1.2;
                         ">

                        <div class="col-3"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                                word-wrap:break-word;
                            ">
                            <strong>Partner Name:</strong>
                            <span t-esc="stmt_data['partner'].name"/>
                        </div>


                        <div class="col-3"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                                word-wrap:break-word;
                            ">
                            <strong>Initial Balance:</strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['opening_balance']
                                )"/>
                            </span>

                            IQD
                        </div>


                        <div class="col-3"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">
                            <strong>From:</strong>

                            <span t-esc="date_from"/>
                        </div>


                        <div class="col-3"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">
                            <strong>To:</strong>

                            <span t-esc="date_to"/>
                        </div>

                    </div>


                    <!-- =========================================================
                        MAIN TABLE + TOTAL
                        ========================================================= -->

                    <table
                        class="table table-sm table-bordered statement-table"
                        style="
                            width:100%;
                            table-layout:fixed;
                            border-collapse:collapse;
                            margin:0;
                        "
                    >

                        <!-- =====================================================
                            FIXED COLUMN WIDTHS
                            مجموعها = 100%
                            ===================================================== -->

                        <colgroup>
                            <col style="width:7%;"/>
                            <col style="width:13%;"/>
                            <col style="width:25%;"/>
                            <col style="width:8%;"/>
                            <col style="width:10%;"/>
                            <col style="width:12%;"/>
                            <col style="width:12%;"/>
                            <col style="width:13%;"/>
                        </colgroup>


                        <!-- =====================================================
                            HEADER
                            ===================================================== -->

                        <thead>

                            <tr>

                                <th
                                    style="
                                        font-size:6.5pt;
                                        padding:2px 2px;
                                        text-align:center;
                                        line-height:1.05;
                                        white-space:normal;
                                    "
                                >
                                    Date
                                </th>

                                <th
                                    style="
                                        font-size:6.5pt;
                                        padding:2px 2px;
                                        text-align:center;
                                        line-height:1.05;
                                        white-space:normal;
                                    "
                                >
                                    Transaction
                                </th>

                                <th
                                    style="
                                        font-size:6.5pt;
                                        padding:2px 2px;
                                        text-align:center;
                                        line-height:1.05;
                                        white-space:normal;
                                    "
                                >
                                    Product / Description
                                </th>

                                <th
                                    style="
                                        font-size:6.5pt;
                                        padding:2px 2px;
                                        text-align:center;
                                        line-height:1.05;
                                        white-space:normal;
                                    "
                                >
                                    Quantity
                                </th>

                                <th
                                    style="
                                        font-size:6.5pt;
                                        padding:2px 2px;
                                        text-align:center;
                                        line-height:1.05;
                                        white-space:normal;
                                    "
                                >
                                    Unit Price
                                </th>

                                <th
                                    style="
                                        font-size:6.5pt;
                                        padding:2px 2px;
                                        text-align:center;
                                        line-height:1.05;
                                        white-space:normal;
                                    "
                                >
                                    Debit
                                </th>

                                <th
                                    style="
                                        font-size:6.5pt;
                                        padding:2px 2px;
                                        text-align:center;
                                        line-height:1.05;
                                        white-space:normal;
                                    "
                                >
                                    Credit
                                </th>

                                <th
                                    style="
                                        font-size:6.5pt;
                                        padding:2px 2px;
                                        text-align:center;
                                        line-height:1.05;
                                        white-space:normal;
                                    "
                                >
                                    Balance
                                </th>

                            </tr>

                        </thead>


                        <!-- =====================================================
                            DATA
                            ===================================================== -->

                        <tbody>

                            <t t-foreach="stmt_data['lines']" t-as="line">

                                <tr>

                                    <!-- DATE -->

                                    <td
                                        style="
                                            font-size:6pt;
                                            padding:2px;
                                            line-height:1.05;
                                            vertical-align:middle;
                                            word-wrap:break-word;
                                            overflow:hidden;
                                        "
                                    >
                                        <span t-esc="line['date']"/>
                                    </td>


                                    <!-- TRANSACTION -->

                                    <td
                                        style="
                                            font-size:6pt;
                                            padding:2px;
                                            line-height:1.05;
                                            vertical-align:middle;
                                            word-wrap:break-word;
                                            overflow:hidden;
                                        "
                                    >
                                        <span t-esc="line['transaction']"/>
                                    </td>


                                    <!-- PRODUCT -->

                                    <td
                                        style="
                                            font-size:6pt;
                                            padding:2px;
                                            line-height:1.05;
                                            vertical-align:middle;
                                            word-wrap:break-word;
                                            overflow:hidden;
                                            white-space:pre-line;
                                        "
                                    >
                                        <span t-esc="line['product']"/>
                                    </td>


                                    <!-- QUANTITY -->

                                    <td
                                        style="
                                            font-size:5.8pt;
                                            padding:2px;
                                            line-height:1.05;
                                            vertical-align:middle;
                                            text-align:right;
                                            word-wrap:break-word;
                                            overflow:hidden;
                                        "
                                    >

                                        <t t-if="line['quantity'] is not None">

                                            <span>
                                                <t t-esc="'{:,.3f}'.format(
                                                    line['quantity']
                                                )"/>
                                            </span>

                                        </t>

                                    </td>


                                    <!-- UNIT PRICE -->

                                    <td
                                        style="
                                            font-size:5.8pt;
                                            padding:2px;
                                            line-height:1.05;
                                            vertical-align:middle;
                                            text-align:right;
                                            word-wrap:break-word;
                                            overflow:hidden;
                                        "
                                    >

                                        <t t-if="line['unit_price'] is not None">

                                            <span>
                                                <t t-esc="'{:,.2f}'.format(
                                                    line['unit_price']
                                                )"/>
                                            </span>

                                        </t>

                                    </td>


                                    <!-- DEBIT -->

                                    <td
                                        style="
                                            font-size:5.8pt;
                                            padding:2px;
                                            line-height:1.05;
                                            vertical-align:middle;
                                            text-align:right;
                                            word-wrap:break-word;
                                            overflow:hidden;
                                        "
                                    >

                                        <span>
                                            <t t-esc="'{:,.2f}'.format(
                                                line['debit']
                                            )"/>
                                        </span>

                                    </td>


                                    <!-- CREDIT -->

                                    <td
                                        style="
                                            font-size:5.8pt;
                                            padding:2px;
                                            line-height:1.05;
                                            vertical-align:middle;
                                            text-align:right;
                                            word-wrap:break-word;
                                            overflow:hidden;
                                        "
                                    >

                                        <span>
                                            <t t-esc="'{:,.2f}'.format(
                                                line['credit']
                                            )"/>
                                        </span>

                                    </td>


                                    <!-- BALANCE -->

                                    <td
                                        style="
                                            font-size:5.6pt;
                                            padding:2px;
                                            line-height:1.05;
                                            vertical-align:middle;
                                            text-align:right;
                                            word-wrap:break-word;
                                            overflow:hidden;
                                            white-space:normal;
                                        "
                                    >

                                        <strong
                                            style="
                                                font-size:5.6pt;
                                                font-weight:bold;
                                                word-wrap:break-word;
                                            "
                                        >
                                            <t t-esc="'{:,.2f}'.format(
                                                line['balance']
                                            )"/>
                                        </strong>

                                    </td>

                                </tr>

                            </t>


                            <!-- =================================================
                                TOTAL
                                مهم:
                                Total أصبح داخل نفس الجدول
                                ================================================= -->

                            <tr>

                                <!-- TOTAL LABEL -->

                                <td
                                    colspan="3"
                                    style="
                                        font-size:6.5pt;
                                        font-weight:bold;
                                        padding:3px 2px;
                                        line-height:1.05;
                                        text-align:left;
                                        vertical-align:middle;
                                    "
                                >
                                    Total
                                </td>


                                <!-- TOTAL QUANTITY -->

                                <td
                                    style="
                                        font-size:6pt;
                                        font-weight:bold;
                                        padding:3px 2px;
                                        line-height:1.05;
                                        text-align:right;
                                        vertical-align:middle;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                    "
                                >

                                    <t t-esc="'{:,.3f}'.format(
                                        stmt_data['total_qty']
                                    )"/>

                                </td>


                                <!-- EMPTY UNIT PRICE -->

                                <td
                                    style="
                                        font-size:6pt;
                                        padding:3px 2px;
                                    "
                                >
                                </td>


                                <!-- TOTAL DEBIT -->

                                <td
                                    style="
                                        font-size:6pt;
                                        font-weight:bold;
                                        padding:3px 2px;
                                        line-height:1.05;
                                        text-align:right;
                                        vertical-align:middle;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                    "
                                >

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_debit']
                                    )"/>

                                </td>


                                <!-- TOTAL CREDIT -->

                                <td
                                    style="
                                        font-size:6pt;
                                        font-weight:bold;
                                        padding:3px 2px;
                                        line-height:1.05;
                                        text-align:right;
                                        vertical-align:middle;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                    "
                                >

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_credit']
                                    )"/>

                                </td>


                                <!-- TOTAL BALANCE -->

                                <td
                                    style="
                                        font-size:5.8pt;
                                        font-weight:bold;
                                        padding:3px 2px;
                                        line-height:1.05;
                                        text-align:right;
                                        vertical-align:middle;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                        white-space:normal;
                                    "
                                >

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['closing_balance']
                                    )"/>

                                </td>

                            </tr>

                        </tbody>

                    </table>



                    <!-- =====================================================
                         FINAL BALANCE
                         ===================================================== -->

                    <div class="row"
                         style="
                            width:100%;
                            margin:7px 0 0 0;
                            font-size:8pt;
                            line-height:1.2;
                            page-break-inside:avoid;
                         ">


                        <div class="col-6"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">

                            <strong>
                                Current Balance:
                            </strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>
                            </span>

                            IQD

                        </div>


                        <div class="col-6"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">

                            <strong>
                                Final Account Balance:
                            </strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>
                            </span>

                            IQD

                        </div>

                    </div>


                    <!-- =====================================================
                         SIGNATURE
                         ===================================================== -->

                    <div class="row"
                         style="
                            width:100%;
                            margin-top:12px;
                            font-size:8pt;
                            line-height:1.2;
                            page-break-inside:avoid;
                         ">


                        <div class="col-6"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">

                            <strong>
                                Accountant Name:
                            </strong>

                            __________________________

                        </div>


                        <div class="col-6"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">

                            <strong>
                                Accountant Signature:
                            </strong>

                            __________________________

                        </div>

                    </div>


                </div>


            </t>


            <!-- =============================================================
                 SEPARATE STATEMENTS
                 ============================================================= -->

            <t t-if="not stmt_data_last">

                <div style="page-break-after:always;"></div>

            </t>


        </t>

    </t>

</template>










    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Customer Statement Report (Balance)</h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="wizard.partner_id.name"/>
                        </div>
                        <div class="col-3">
                            <strong>Initial Balance:</strong>
                            <span t-esc="'%.2f' % stmt['opening_balance']"/> IQD
                        </div>
                        <div class="col-3">
                            <strong>From:</strong>
                            <span t-esc="wizard.date_from"/>
                        </div>
                        <div class="col-3">
                            <strong>To:</strong>
                            <span t-esc="wizard.date_to"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="stmt['lines']" t-as="line">
                                <td t-esc="line['date']"/>
                                <td t-esc="line['transaction']"/>
                                <td t-esc="line['product']"/>
                                <td t-esc="line['quantity']"/>
                                <td t-esc="'%.2f' % line['unit_price']"/>
                                <td t-esc="'%.2f' % line['debit']"/>
                                <td t-esc="'%.2f' % line['credit']"/>
                                <td t-esc="'%.2f' % line['balance']"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="text-end mt-3">
                        <strong>Closing Balance: </strong>
                        <span t-esc="'%.2f' % stmt['closing_balance']"/> IQD
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>