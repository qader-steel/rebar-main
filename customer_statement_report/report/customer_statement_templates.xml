<template id="from_lines">

    <t t-call="web.html_container">

        <t t-foreach="statements" t-as="stmt_data">

            <t t-call="web.external_layout">

                <div class="page"
                     style="
                        width: 100%;
                        font-size: 6pt;
                        line-height: 1.0;
                        box-sizing: border-box;
                     ">

                    <!-- =====================================================
                         TITLE
                         ===================================================== -->

                    <h2 class="text-center"
                        style="
                            font-size: 11pt !important;
                            line-height: 1.0;
                            margin: 0 0 4px 0;
                            padding: 0;
