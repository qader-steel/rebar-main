<template id="from_lines">

    <t t-call="web.html_container">

        <t t-foreach="statements" t-as="stmt_data">

            <t t-call="web.external_layout">

                <div class="page"
                     style="
                        width:100%;
                        font-size:8pt;
                        line-height:1.15;
                        box-sizing:border-box;
                        overflow:hidden;
                     ">

                    <!-- =====================================================
                         TITLE
                         ===================================================== -->

                    <h2 class="text-center"
                        style="
                            font-size:14pt;
                            line-height:1.15;
                            margin:0 0 8px 0;
                            padding:0;
                            font-weight:bold;
                        ">
                        Customer Statement Report
                    </h2>


                    <!-- =====================================================
                         STATEMENT INFORMATION
                         ===================================================== -->

                    <div class="row"
                         style="
                            width:100%;
                            margin:0 0 8px 0;
                            font-size:8pt;
                            line-height:1.2;
                         ">

                        <div class="col-3"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                                word-wrap:break-word;
                            ">
                            <strong>Partner Name:</strong>
                            <span t-esc="stmt_data['partner'].name"/>
                        </div>


                        <div class="col-3"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                                word-wrap:break-word;
                            ">
                            <strong>Initial Balance:</strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['opening_balance']
                                )"/>
                            </span>

                            IQD
                        </div>


                        <div class="col-3"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">
                            <strong>From:</strong>

                            <span t-esc="date_from"/>
                        </div>


                        <div class="col-3"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">
                            <strong>To:</strong>

                            <span t-esc="date_to"/>
                        </div>

                    </div>


                    <!-- =====================================================
                         MAIN STATEMENT TABLE
                         ===================================================== -->

                    <table class="table table-sm table-bordered"
                           style="
                                width:100% !important;
                                max-width:100% !important;
                                table-layout:fixed !important;
                                border-collapse:collapse !important;
                                border-spacing:0 !important;
                                margin:0 0 8px 0 !important;
                                padding:0 !important;
                                font-size:8pt !important;
                                line-height:1.15 !important;
                                box-sizing:border-box !important;
                                overflow:hidden !important;
                           ">


                        <!-- =================================================
                             COLUMN WIDTHS
                             Total = 100%
                             ================================================= -->

                        <colgroup>

                            <!-- Date -->
                            <col style="width:8%;"/>

                            <!-- Transaction -->
                            <col style="width:13%;"/>

                            <!-- Description -->
                            <col style="width:24%;"/>

                            <!-- Quantity -->
                            <col style="width:8%;"/>

                            <!-- Unit Price -->
                            <col style="width:11%;"/>

                            <!-- Debit -->
                            <col style="width:12%;"/>

                            <!-- Credit -->
                            <col style="width:12%;"/>

                            <!-- Balance -->
                            <col style="width:12%;"/>

                        </colgroup>


                        <!-- =================================================
                             TABLE HEADER
                             ================================================= -->

                        <thead>

                            <tr>

                                <th style="
                                    width:8%;
                                    padding:4px 3px !important;
                                    font-size:8pt !important;
                                    line-height:1.1 !important;
                                    text-align:center;
                                    vertical-align:middle;
                                    white-space:normal;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                    box-sizing:border-box;
                                ">
                                    Date
                                </th>


                                <th style="
                                    width:13%;
                                    padding:4px 3px !important;
                                    font-size:8pt !important;
                                    line-height:1.1 !important;
                                    text-align:center;
                                    vertical-align:middle;
                                    white-space:normal;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                    box-sizing:border-box;
                                ">
                                    Transaction
                                </th>


                                <th style="
                                    width:24%;
                                    padding:4px 3px !important;
                                    font-size:8pt !important;
                                    line-height:1.1 !important;
                                    text-align:center;
                                    vertical-align:middle;
                                    white-space:normal;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                    box-sizing:border-box;
                                ">
                                    Product / Description
                                </th>


                                <th style="
                                    width:8%;
                                    padding:4px 2px !important;
                                    font-size:8pt !important;
                                    line-height:1.1 !important;
                                    text-align:center;
                                    vertical-align:middle;
                                    white-space:normal;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                    box-sizing:border-box;
                                ">
                                    Quantity
                                </th>


                                <th style="
                                    width:11%;
                                    padding:4px 2px !important;
                                    font-size:8pt !important;
                                    line-height:1.1 !important;
                                    text-align:center;
                                    vertical-align:middle;
                                    white-space:normal;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                    box-sizing:border-box;
                                ">
                                    Unit Price
                                </th>


                                <th style="
                                    width:12%;
                                    padding:4px 2px !important;
                                    font-size:8pt !important;
                                    line-height:1.1 !important;
                                    text-align:center;
                                    vertical-align:middle;
                                    white-space:normal;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                    box-sizing:border-box;
                                ">
                                    Debit
                                </th>


                                <th style="
                                    width:12%;
                                    padding:4px 2px !important;
                                    font-size:8pt !important;
                                    line-height:1.1 !important;
                                    text-align:center;
                                    vertical-align:middle;
                                    white-space:normal;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                    box-sizing:border-box;
                                ">
                                    Credit
                                </th>


                                <th style="
                                    width:12%;
                                    padding:4px 2px !important;
                                    font-size:8pt !important;
                                    line-height:1.1 !important;
                                    text-align:center;
                                    vertical-align:middle;
                                    white-space:normal;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                    box-sizing:border-box;
                                ">
                                    Balance
                                </th>

                            </tr>

                        </thead>


                        <!-- =================================================
                             TABLE BODY
                             ================================================= -->

                        <tbody>

                            <t t-foreach="stmt_data['lines']" t-as="line">

                                <tr>


                                    <!-- ================================
                                         DATE
                                         ================================ -->

                                    <td style="
                                        width:8%;
                                        padding:3px 3px !important;
                                        font-size:7.5pt !important;
                                        line-height:1.1 !important;
                                        vertical-align:middle;
                                        text-align:left;
                                        white-space:normal;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                        box-sizing:border-box;
                                    ">
                                        <span t-esc="line['date']"/>
                                    </td>


                                    <!-- ================================
                                         TRANSACTION
                                         ================================ -->

                                    <td style="
                                        width:13%;
                                        padding:3px 3px !important;
                                        font-size:7.5pt !important;
                                        line-height:1.1 !important;
                                        vertical-align:middle;
                                        text-align:left;
                                        white-space:normal;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                        box-sizing:border-box;
                                    ">
                                        <span t-esc="line['transaction']"/>
                                    </td>


                                    <!-- ================================
                                         PRODUCT / DESCRIPTION
                                         ================================ -->

                                    <td style="
                                        width:24%;
                                        padding:3px 3px !important;
                                        font-size:7.5pt !important;
                                        line-height:1.15 !important;
                                        vertical-align:middle;
                                        text-align:left;
                                        white-space:pre-line !important;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                        box-sizing:border-box;
                                    ">
                                        <span t-esc="line['product']"/>
                                    </td>


                                    <!-- ================================
                                         QUANTITY
                                         ================================ -->

                                    <td style="
                                        width:8%;
                                        padding:3px 2px !important;
                                        font-size:7.2pt !important;
                                        line-height:1.1 !important;
                                        vertical-align:middle;
                                        text-align:right;
                                        white-space:normal;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                        box-sizing:border-box;
                                    ">

                                        <t t-if="line['quantity'] is not None">

                                            <span>
                                                <t t-esc="'{:,.3f}'.format(
                                                    line['quantity']
                                                )"/>
                                            </span>

                                        </t>

                                    </td>


                                    <!-- ================================
                                         UNIT PRICE
                                         ================================ -->

                                    <td style="
                                        width:11%;
                                        padding:3px 2px !important;
                                        font-size:7.2pt !important;
                                        line-height:1.1 !important;
                                        vertical-align:middle;
                                        text-align:right;
                                        white-space:normal;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                        box-sizing:border-box;
                                    ">

                                        <t t-if="line['unit_price'] is not None">

                                            <span>
                                                <t t-esc="'{:,.2f}'.format(
                                                    line['unit_price']
                                                )"/>
                                            </span>

                                        </t>

                                    </td>


                                    <!-- ================================
                                         DEBIT
                                         ================================ -->

                                    <td style="
                                        width:12%;
                                        padding:3px 2px !important;
                                        font-size:7.2pt !important;
                                        line-height:1.1 !important;
                                        vertical-align:middle;
                                        text-align:right;
                                        white-space:normal;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                        box-sizing:border-box;
                                    ">

                                        <span>
                                            <t t-esc="'{:,.2f}'.format(
                                                line['debit']
                                            )"/>
                                        </span>

                                    </td>


                                    <!-- ================================
                                         CREDIT
                                         ================================ -->

                                    <td style="
                                        width:12%;
                                        padding:3px 2px !important;
                                        font-size:7.2pt !important;
                                        line-height:1.1 !important;
                                        vertical-align:middle;
                                        text-align:right;
                                        white-space:normal;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                        box-sizing:border-box;
                                    ">

                                        <span>
                                            <t t-esc="'{:,.2f}'.format(
                                                line['credit']
                                            )"/>
                                        </span>

                                    </td>


                                    <!-- ================================
                                         BALANCE
                                         ================================ -->

                                    <td style="
                                        width:12%;
                                        padding:3px 2px !important;
                                        font-size:7pt !important;
                                        line-height:1.1 !important;
                                        vertical-align:middle;
                                        text-align:right;
                                        white-space:normal !important;
                                        word-wrap:break-word !important;
                                        overflow:hidden !important;
                                        box-sizing:border-box !important;
                                    ">

                                        <strong style="
                                            font-size:7pt !important;
                                            font-weight:bold;
                                            line-height:1.1 !important;
                                            white-space:normal !important;
                                            word-wrap:break-word !important;
                                        ">

                                            <t t-esc="'{:,.2f}'.format(
                                                line['balance']
                                            )"/>

                                        </strong>

                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>


                    <!-- =====================================================
                         TOTAL
                         ===================================================== -->

                    <div style="
                        width:100%;
                        margin-top:4px;
                        margin-bottom:8px;
                        page-break-inside:avoid;
                        overflow:hidden;
                    ">

                        <table class="table table-sm table-bordered"
                               style="
                                    width:100% !important;
                                    max-width:100% !important;
                                    table-layout:fixed !important;
                                    border-collapse:collapse !important;
                                    margin:0 !important;
                                    font-size:7.5pt !important;
                                    line-height:1.1 !important;
                                ">

                            <colgroup>

                                <col style="width:32%;"/>
                                <col style="width:8%;"/>
                                <col style="width:11%;"/>
                                <col style="width:12%;"/>
                                <col style="width:12%;"/>
                                <col style="width:25%;"/>

                            </colgroup>

                            <tr>

                                <th colspan="3"
                                    style="
                                        padding:4px 3px !important;
                                        font-size:7.5pt !important;
                                        text-align:left;
                                        vertical-align:middle;
                                        word-wrap:break-word;
                                        overflow:hidden;
                                    ">
                                    Total
                                </th>


                                <th style="
                                    padding:4px 2px !important;
                                    font-size:7.2pt !important;
                                    text-align:right;
                                    vertical-align:middle;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                ">

                                    <t t-esc="'{:,.3f}'.format(
                                        stmt_data['total_qty']
                                    )"/>

                                </th>


                                <th style="
                                    padding:4px 2px !important;
                                    font-size:7.2pt !important;
                                    text-align:right;
                                    vertical-align:middle;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                ">
                                </th>


                                <th style="
                                    padding:4px 2px !important;
                                    font-size:7.2pt !important;
                                    text-align:right;
                                    vertical-align:middle;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                ">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_debit']
                                    )"/>

                                </th>


                                <th style="
                                    padding:4px 2px !important;
                                    font-size:7.2pt !important;
                                    text-align:right;
                                    vertical-align:middle;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                ">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_credit']
                                    )"/>

                                </th>


                                <th style="
                                    padding:4px 2px !important;
                                    font-size:7.2pt !important;
                                    text-align:right;
                                    vertical-align:middle;
                                    word-wrap:break-word;
                                    overflow:hidden;
                                ">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['closing_balance']
                                    )"/>

                                </th>

                            </tr>

                        </table>

                    </div>


                    <!-- =====================================================
                         FINAL BALANCE
                         ===================================================== -->

                    <div class="row"
                         style="
                            width:100%;
                            margin:7px 0 0 0;
                            font-size:8pt;
                            line-height:1.2;
                            page-break-inside:avoid;
                         ">


                        <div class="col-6"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">

                            <strong>
                                Current Balance:
                            </strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>
                            </span>

                            IQD

                        </div>


                        <div class="col-6"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">

                            <strong>
                                Final Account Balance:
                            </strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>
                            </span>

                            IQD

                        </div>

                    </div>


                    <!-- =====================================================
                         SIGNATURE
                         ===================================================== -->

                    <div class="row"
                         style="
                            width:100%;
                            margin-top:12px;
                            font-size:8pt;
                            line-height:1.2;
                            page-break-inside:avoid;
                         ">


                        <div class="col-6"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">

                            <strong>
                                Accountant Name:
                            </strong>

                            __________________________

                        </div>


                        <div class="col-6"
                             style="
                                padding-left:3px;
                                padding-right:3px;
                            ">

                            <strong>
                                Accountant Signature:
                            </strong>

                            __________________________

                        </div>

                    </div>


                </div>


            </t>


            <!-- =============================================================
                 SEPARATE STATEMENTS
                 ============================================================= -->

            <t t-if="not stmt_data_last">

                <div style="page-break-after:always;"></div>

            </t>


        </t>

