                                            width: 8%;
                                            padding: 1px !important;
                                            font-size: 4.5pt !important;
                                            line-height: 0.9 !important;
                                            vertical-align: middle;
                                            white-space: normal;
                                            word-wrap: break-word;
                                            overflow: hidden;
