<template id="from_lines">

    <t t-call="web.html_container">

        <style>

            /* ================================
               Page / Report Size
               ================================ */

            .page {
                font-size: 8px;
                line-height: 1.15;
            }

            .statement-title {
                font-size: 16px;
                margin: 0 0 8px 0;
            }

            .statement-info {
                font-size: 8px;
                margin-bottom: 8px;
            }

            .statement-info .col-3 {
                padding-left: 4px;
                padding-right: 4px;
            }


            /* ================================
               Main Table
               ================================ */

            .statement-table {
                width: 100%;
                font-size: 7.5px;
                line-height: 1.1;
                margin-bottom: 8px;
            }

            .statement-table th,
            .statement-table td {
                padding: 3px 4px !important;
                vertical-align: middle;
            }

            .statement-table thead th {
                font-size: 7.5px;
                font-weight: bold;
                white-space: nowrap;
            }

            .statement-table td {
                word-break: normal;
            }


            /* ================================
               Final Total
               IMPORTANT:
               Outside the table so it appears
               only once after all pages.
               ================================ */

            .statement-total {
                width: 100%;
                font-size: 8px;
                margin-top: 5px;
                margin-bottom: 10px;
                page-break-inside: avoid;
            }

            .statement-total table {
                width: 100%;
            }

            .statement-total th,
            .statement-total td {
                padding: 4px !important;
                font-weight: bold;
            }


            /* ================================
               Final Balance Section
               ================================ */

            .statement-balance {
                font-size: 8px;
                margin-top: 8px;
                page-break-inside: avoid;
            }

            .statement-signature {
                font-size: 8px;
                margin-top: 12px;
                page-break-inside: avoid;
            }

            .statement-signature .col-6 {
                padding-left: 5px;
                padding-right: 5px;
            }

        </style>


        <t t-foreach="statements" t-as="stmt_data">

            <t t-call="web.external_layout">

                <div class="page">

                    <!-- ==========================
                         Report Title
                         ========================== -->

                    <h2 class="text-center statement-title">
                        Customer Statement Report
                    </h2>


                    <!-- ==========================
                         Statement Information
                         ========================== -->

                    <div class="row statement-info">

                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="stmt_data['partner'].name"/>
                        </div>

                        <div class="col-3">
                            <strong>Initial Balance:</strong>
                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['opening_balance']
                                )"/>
                            </span>
                            IQD
                        </div>

                        <div class="col-3">
                            <strong>From:</strong>
                            <span t-esc="date_from"/>
                        </div>

                        <div class="col-3">
                            <strong>To:</strong>
                            <span t-esc="date_to"/>
                        </div>

                    </div>


                    <!-- ==========================
                         Statement Lines
                         ========================== -->

                    <table class="table table-sm table-bordered statement-table">

                        <thead>

                            <tr>

                                <th>Date</th>

                                <th>Transaction</th>

                                <th>Product / Description</th>

                                <th class="text-end">
                                    Quantity
                                </th>

                                <th class="text-end">
                                    Unit Price
                                </th>

                                <th class="text-end">
                                    Debit
                                </th>

                                <th class="text-end">
                                    Credit
                                </th>

                                <th class="text-end">
                                    Balance
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t t-foreach="stmt_data['lines']" t-as="line">

                                <tr>

                                    <td>
                                        <span t-esc="line['date']"/>
                                    </td>


                                    <td>
                                        <span t-esc="line['transaction']"/>
                                    </td>


                                    <td style="white-space: pre-line;">
                                        <span t-esc="line['product']"/>
                                    </td>


                                    <td class="text-end">

                                        <t t-if="line['quantity'] is not None">

                                            <span>
                                                <t t-esc="'{:,.3f}'.format(
                                                    line['quantity']
                                                )"/>
                                            </span>

                                        </t>

                                    </td>


                                    <td class="text-end">

                                        <t t-if="line['unit_price'] is not None">

                                            <span>
                                                <t t-esc="'{:,.2f}'.format(
                                                    line['unit_price']
                                                )"/>
                                            </span>

                                        </t>

                                    </td>


                                    <td class="text-end">

                                        <span>
                                            <t t-esc="'{:,.2f}'.format(
                                                line['debit']
                                            )"/>
                                        </span>

                                    </td>


                                    <td class="text-end">

                                        <span>
                                            <t t-esc="'{:,.2f}'.format(
                                                line['credit']
                                            )"/>
                                        </span>

                                    </td>


                                    <td class="text-end">

                                        <strong>
                                            <t t-esc="'{:,.2f}'.format(
                                                line['balance']
                                            )"/>
                                        </strong>

                                    </td>

                                </tr>

                            </t>

                        </tbody>

                    </table>


                    <!-- ==========================
                         GLOBAL TOTAL
                         NOT inside table
                         ========================== -->

                    <div class="statement-total">

                        <table class="table table-sm table-bordered">

                            <tr>

                                <th colspan="3">
                                    Total
                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.3f}'.format(
                                        stmt_data['total_qty']
                                    )"/>

                                </th>


                                <th></th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_debit']
                                    )"/>

                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_credit']
                                    )"/>

                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['closing_balance']
                                    )"/>

                                </th>

                            </tr>

                        </table>

                    </div>


                    <!-- ==========================
                         Final Balance
                         ========================== -->

                    <div class="row statement-balance">

                        <div class="col-6">

                            <strong>
                                Current Balance:
                            </strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>
                            </span>

                            IQD

                        </div>


                        <div class="col-6">

                            <strong>
                                Final Account Balance:
                            </strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>
                            </span>

                            IQD

                        </div>

                    </div>


                    <!-- ==========================
                         Accountant Signature
                         ========================== -->

                    <div class="row statement-signature">

                        <div class="col-6">

                            <strong>
                                Accountant Name:
                            </strong>

                            __________________________

                        </div>


                        <div class="col-6">

                            <strong>
                                Accountant Signature:
                            </strong>

                            __________________________

                        </div>

                    </div>

                </div>

            </t>


            <!-- Separate statements -->
            <t t-if="not stmt_data_last">
                <div style="page-break-after: always;"/>
            </t>

        </t>

    </t>

</template>


    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Customer Statement Report (Balance)</h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="wizard.partner_id.name"/>
                        </div>
                        <div class="col-3">
                            <strong>Initial Balance:</strong>
                            <span t-esc="'%.2f' % stmt['opening_balance']"/> IQD
                        </div>
                        <div class="col-3">
                            <strong>From:</strong>
                            <span t-esc="wizard.date_from"/>
                        </div>
                        <div class="col-3">
                            <strong>To:</strong>
                            <span t-esc="wizard.date_to"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="stmt['lines']" t-as="line">
                                <td t-esc="line['date']"/>
                                <td t-esc="line['transaction']"/>
                                <td t-esc="line['product']"/>
                                <td t-esc="line['quantity']"/>
                                <td t-esc="'%.2f' % line['unit_price']"/>
                                <td t-esc="'%.2f' % line['debit']"/>
                                <td t-esc="'%.2f' % line['credit']"/>
                                <td t-esc="'%.2f' % line['balance']"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="text-end mt-3">
                        <strong>Closing Balance: </strong>
                        <span t-esc="'%.2f' % stmt['closing_balance']"/> IQD
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>