<odoo>
    <template id="from_lines">
        <t t-call="web.html_container">
            <t t-foreach="statements" t-as="stmt_data">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Customer Statement Report (Balance)</h2>
                        <div class="row mt-3 mb-3">
                            <div class="col-3">
                                <strong>Partner Name:</strong>
                                <span t-esc="stmt_data['partner'].name"/>
                            </div>
                            <div class="col-3">
                                <strong>Initial Balance:</strong>
                                <span t-esc="'%.2f' % stmt_data['opening_balance']"/> IQD
                            </div>
                            <div class="col-3">
                                <strong>From:</strong>
                                <span t-esc="date_from"/>
                            </div>
                            <div class="col-3">
                                <strong>To:</strong>
                                <span t-esc="date_to"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Journal Entry</th>
                                    <th>Account</th>
                                    <th>Label</th>
                                    <th>Debit</th>
                                    <th>Credit</th>
                                    <th>Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="stmt_data['lines']" t-as="line">
                                    <td t-esc="line['date']"/>
                                    <td t-esc="line['move_name']"/>
                                    <td t-esc="line['account']"/>
                                    <td t-esc="line['label']"/>
                                    <td t-esc="'%.2f' % line['debit']"/>
                                    <td t-esc="'%.2f' % line['credit']"/>
                                    <td t-esc="'%.2f' % line['balance']"/>
                                </tr>
                            </tbody>
                        </table>

                        <div class="text-end mt-3">
                            <strong>Closing Balance: </strong>
                            <span t-esc="'%.2f' % stmt_data['closing_balance']"/> IQD
                        </div>
                    </div>
                </t>
                <p style="page-break-after: always;"/>
            </t>
        </t>
    </template>

    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Customer Statement Report (Balance)</h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="wizard.partner_id.name"/>
                        </div>
                        <div class="col-3">
                            <strong>Initial Balance:</strong>
                            <span t-esc="'%.2f' % stmt['opening_balance']"/> IQD
                        </div>
                        <div class="col-3">
                            <strong>From:</strong>
                            <span t-esc="wizard.date_from"/>
                        </div>
                        <div class="col-3">
                            <strong>To:</strong>
                            <span t-esc="wizard.date_to"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="stmt['lines']" t-as="line">
                                <td t-esc="line['date']"/>
                                <td t-esc="line['transaction']"/>
                                <td t-esc="line['product']"/>
                                <td t-esc="line['quantity']"/>
                                <td t-esc="'%.2f' % line['unit_price']"/>
                                <td t-esc="'%.2f' % line['debit']"/>
                                <td t-esc="'%.2f' % line['credit']"/>
                                <td t-esc="'%.2f' % line['balance']"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="text-end mt-3">
                        <strong>Closing Balance: </strong>
                        <span t-esc="'%.2f' % stmt['closing_balance']"/> IQD
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>