<template id="from_lines">

    <t t-call="web.html_container">

        <style>

            /* =========================================================
            REPORT BASE
            ========================================================= */

            #statement-wrapper {
                width: 100%;
                font-size: 5.5pt;
                line-height: 1.0;
            }

            #statement-wrapper .statement-title {
                font-size: 11pt;
                line-height: 1.0;
                margin: 0 0 4px 0;
            }

            #statement-wrapper .statement-info {
                width: 100%;
                font-size: 5.5pt;
                line-height: 1.0;
                margin-bottom: 4px;
            }

            #statement-wrapper .statement-info .col-3 {
                padding-left: 1px;
                padding-right: 1px;
            }


            /* =========================================================
            MAIN TABLE
            ========================================================= */

            #statement-wrapper table.statement-table {
                width: 100% !important;

                table-layout: fixed !important;

                border-collapse: collapse !important;

                margin: 0 !important;
                padding: 0 !important;

                font-size: 5pt !important;
                line-height: 0.95 !important;

                box-sizing: border-box !important;

                word-wrap: break-word !important;
            }


            /* =========================================================
            ALL TABLE CELLS
            ========================================================= */

            #statement-wrapper table.statement-table th,
            #statement-wrapper table.statement-table td {

                box-sizing: border-box !important;

                font-size: 5pt !important;

                line-height: 0.95 !important;

                padding: 1px 1px !important;

                margin: 0 !important;

                vertical-align: middle !important;

                white-space: normal !important;

                word-wrap: break-word !important;

                overflow-wrap: break-word !important;

                overflow: hidden !important;

                max-width: 0 !important;
            }


            /* =========================================================
            HEADER
            ========================================================= */

            #statement-wrapper table.statement-table thead th {

                font-size: 5pt !important;

                line-height: 0.95 !important;

                font-weight: bold !important;

                text-align: center !important;

                white-space: normal !important;

                word-wrap: break-word !important;

                overflow: hidden !important;
            }


            /* =========================================================
            COLUMN WIDTHS
            
            IMPORTANT:
            TOTAL = 94%
            Leave 6% safety margin for wkhtmltopdf.
            ========================================================= */


            /* DATE */

            #statement-wrapper table.statement-table th:nth-child(1),
            #statement-wrapper table.statement-table td:nth-child(1) {

                width: 7% !important;

                font-size: 4.7pt !important;

                max-width: 7% !important;

                overflow: hidden !important;

                word-wrap: break-word !important;
            }


            /* TRANSACTION */

            #statement-wrapper table.statement-table th:nth-child(2),
            #statement-wrapper table.statement-table td:nth-child(2) {

                width: 11% !important;

                font-size: 4.5pt !important;

                max-width: 11% !important;

                overflow: hidden !important;

                word-wrap: break-word !important;
            }


            /* PRODUCT / DESCRIPTION */

            #statement-wrapper table.statement-table th:nth-child(3),
            #statement-wrapper table.statement-table td:nth-child(3) {

                width: 25% !important;

                font-size: 5pt !important;

                max-width: 25% !important;

                overflow: hidden !important;

                word-wrap: break-word !important;
            }


            /* QUANTITY */

            #statement-wrapper table.statement-table th:nth-child(4),
            #statement-wrapper table.statement-table td:nth-child(4) {

                width: 8% !important;

                font-size: 4.5pt !important;

                max-width: 8% !important;

                text-align: right !important;

                overflow: hidden !important;
            }


            /* UNIT PRICE */

            #statement-wrapper table.statement-table th:nth-child(5),
            #statement-wrapper table.statement-table td:nth-child(5) {

                width: 10% !important;

                font-size: 4.5pt !important;

                max-width: 10% !important;

                text-align: right !important;

                overflow: hidden !important;
            }


            /* DEBIT */

            #statement-wrapper table.statement-table th:nth-child(6),
            #statement-wrapper table.statement-table td:nth-child(6) {

                width: 11% !important;

                font-size: 4.5pt !important;

                max-width: 11% !important;

                text-align: right !important;

                overflow: hidden !important;
            }


            /* CREDIT */

            #statement-wrapper table.statement-table th:nth-child(7),
            #statement-wrapper table.statement-table td:nth-child(7) {

                width: 11% !important;

                font-size: 4.5pt !important;

                max-width: 11% !important;

                text-align: right !important;

                overflow: hidden !important;
            }


            /* BALANCE */

            #statement-wrapper table.statement-table th:nth-child(8),
            #statement-wrapper table.statement-table td:nth-child(8) {

                width: 11% !important;

                font-size: 4.2pt !important;

                max-width: 11% !important;

                min-width: 0 !important;

                text-align: right !important;

                overflow: hidden !important;

                white-space: normal !important;

                word-wrap: break-word !important;
            }


            /* =========================================================
            FORCE NUMERIC CONTENT TO STAY INSIDE CELL
            ========================================================= */

            #statement-wrapper table.statement-table td span,
            #statement-wrapper table.statement-table td strong {

                display: inline !important;

                max-width: 100% !important;

                font-size: 4.5pt !important;

                line-height: 0.95 !important;

                white-space: normal !important;

                word-wrap: break-word !important;

                overflow-wrap: break-word !important;
            }


            /* BALANCE NUMBER */

            #statement-wrapper table.statement-table td:nth-child(8) strong {

                font-size: 4.2pt !important;

                font-weight: bold !important;

                white-space: normal !important;

                word-wrap: break-word !important;

                overflow-wrap: break-word !important;
            }


            /* =========================================================
            NUMERIC CELLS
            ========================================================= */

            #statement-wrapper table.statement-table .text-end {

                text-align: right !important;

                white-space: normal !important;

                word-wrap: break-word !important;

                overflow-wrap: break-word !important;

                max-width: 0 !important;
            }


            /* =========================================================
            TOTAL
            ========================================================= */

            #statement-wrapper .statement-total {

                width: 100% !important;

                font-size: 5pt !important;

                margin-top: 2px !important;

                margin-bottom: 4px !important;

                page-break-inside: avoid !important;
            }


            #statement-wrapper .statement-total table {

                width: 100% !important;

                table-layout: fixed !important;

                border-collapse: collapse !important;

                box-sizing: border-box !important;
            }


            #statement-wrapper .statement-total th,
            #statement-wrapper .statement-total td {

                font-size: 4.5pt !important;

                line-height: 0.95 !important;

                padding: 1px !important;

                font-weight: bold !important;

                white-space: normal !important;

                word-wrap: break-word !important;

                overflow: hidden !important;

                box-sizing: border-box !important;
            }


            /* =========================================================
            FINAL BALANCE
            ========================================================= */

            #statement-wrapper .statement-balance {

                width: 100% !important;

                font-size: 5pt !important;

                line-height: 1.0 !important;

                margin-top: 4px !important;

                page-break-inside: avoid !important;
            }


            #statement-wrapper .statement-balance .col-6 {

                padding-left: 1px !important;

                padding-right: 1px !important;
            }


            /* =========================================================
            SIGNATURE
            ========================================================= */

            #statement-wrapper .statement-signature {

                width: 100% !important;

                font-size: 5pt !important;

                line-height: 1.0 !important;

                margin-top: 6px !important;

                page-break-inside: avoid !important;
            }


            #statement-wrapper .statement-signature .col-6 {

                padding-left: 1px !important;

                padding-right: 1px !important;
            }

        </style>


        <!-- =========================================================
             STATEMENTS
             ========================================================= -->

        <t t-foreach="statements" t-as="stmt_data">

            <t t-call="web.external_layout">

                <!-- IMPORTANT:
                     ID is directly on the page wrapper
                -->

                <div id="statement-wrapper" class="page">


                    <!-- =================================================
                         TITLE
                         ================================================= -->

                    <h2 class="text-center statement-title">

                        Customer Statement Report

                    </h2>


                    <!-- =================================================
                         INFORMATION
                         ================================================= -->

                    <div class="row statement-info">

                        <div class="col-3">

                            <strong>
                                Partner Name:
                            </strong>

                            <span t-esc="stmt_data['partner'].name"/>

                        </div>


                        <div class="col-3">

                            <strong>
                                Initial Balance:
                            </strong>

                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['opening_balance']
                                )"/>

                            </span>

                            IQD

                        </div>


                        <div class="col-3">

                            <strong>
                                From:
                            </strong>

                            <span t-esc="date_from"/>

                        </div>


                        <div class="col-3">

                            <strong>
                                To:
                            </strong>

                            <span t-esc="date_to"/>

                        </div>

                    </div>


                    <!-- =================================================
                         MAIN TABLE
                         ================================================= -->

                    <table class="table table-sm table-bordered statement-table">


                        <thead>

                            <tr>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Transaction
                                </th>

                                <th>
                                    Product / Description
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th>
                                    Unit Price
                                </th>

                                <th>
                                    Debit
                                </th>

                                <th>
                                    Credit
                                </th>

                                <th>
                                    Balance
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t t-foreach="stmt_data['lines']" t-as="line">

                                <tr>


                                    <!-- DATE -->

                                    <td>

                                        <span t-esc="line['date']"/>

                                    </td>


                                    <!-- TRANSACTION -->

                                    <td>

                                        <span t-esc="line['transaction']"/>

                                    </td>


                                    <!-- PRODUCT -->

                                    <td>

                                        <span t-esc="line['product']"/>

                                    </td>


                                    <!-- QUANTITY -->

                                    <td class="text-end">

                                        <t t-if="line['quantity'] is not None">

                                            <span>

                                                <t t-esc="'{:,.3f}'.format(
                                                    line['quantity']
                                                )"/>

                                            </span>

                                        </t>

                                    </td>


                                    <!-- UNIT PRICE -->

                                    <td class="text-end">

                                        <t t-if="line['unit_price'] is not None">

                                            <span>

                                                <t t-esc="'{:,.2f}'.format(
                                                    line['unit_price']
                                                )"/>

                                            </span>

                                        </t>

                                    </td>


                                    <!-- DEBIT -->

                                    <td class="text-end">

                                        <span>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['debit']
                                            )"/>

                                        </span>

                                    </td>


                                    <!-- CREDIT -->

                                    <td class="text-end">

                                        <span>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['credit']
                                            )"/>

                                        </span>

                                    </td>


                                    <!-- BALANCE -->

                                    <td class="text-end">

                                        <strong>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['balance']
                                            )"/>

                                        </strong>

                                    </td>


                                </tr>

                            </t>

                        </tbody>

                    </table>


                    <!-- =================================================
                         TOTAL
                         ================================================= -->

                    <div class="statement-total">

                        <table class="table table-sm table-bordered">

                            <tr>

                                <th colspan="3">

                                    Total

                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.3f}'.format(
                                        stmt_data['total_qty']
                                    )"/>

                                </th>


                                <th>
                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_debit']
                                    )"/>

                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_credit']
                                    )"/>

                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['closing_balance']
                                    )"/>

                                </th>

                            </tr>

                        </table>

                    </div>


                    <!-- =================================================
                         FINAL BALANCE
                         ================================================= -->

                    <div class="row statement-balance">

                        <div class="col-6">

                            <strong>
                                Current Balance:
                            </strong>

                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>

                            </span>

                            IQD

                        </div>


                        <div class="col-6">

                            <strong>
                                Final Account Balance:
                            </strong>

                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>

                            </span>

                            IQD

                        </div>

                    </div>


                    <!-- =================================================
                         SIGNATURE
                         ================================================= -->

                    <div class="row statement-signature">

                        <div class="col-6">

                            <strong>
                                Accountant Name:
                            </strong>

                            __________________________

                        </div>


                        <div class="col-6">

                            <strong>
                                Accountant Signature:
                            </strong>

                            __________________________

                        </div>

                    </div>


                </div>

            </t>


            <!-- =========================================================
                 PAGE BREAK BETWEEN STATEMENTS
                 ========================================================= -->

            <t t-if="not stmt_data_last">

                <div style="page-break-after: always;"></div>

            </t>

        </t>

    </t>

</template>












    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Customer Statement Report (Balance)</h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="wizard.partner_id.name"/>
                        </div>
                        <div class="col-3">
                            <strong>Initial Balance:</strong>
                            <span t-esc="'%.2f' % stmt['opening_balance']"/> IQD
                        </div>
                        <div class="col-3">
                            <strong>From:</strong>
                            <span t-esc="wizard.date_from"/>
                        </div>
                        <div class="col-3">
                            <strong>To:</strong>
                            <span t-esc="wizard.date_to"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="stmt['lines']" t-as="line">
                                <td t-esc="line['date']"/>
                                <td t-esc="line['transaction']"/>
                                <td t-esc="line['product']"/>
                                <td t-esc="line['quantity']"/>
                                <td t-esc="'%.2f' % line['unit_price']"/>
                                <td t-esc="'%.2f' % line['debit']"/>
                                <td t-esc="'%.2f' % line['credit']"/>
                                <td t-esc="'%.2f' % line['balance']"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="text-end mt-3">
                        <strong>Closing Balance: </strong>
                        <span t-esc="'%.2f' % stmt['closing_balance']"/> IQD
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>