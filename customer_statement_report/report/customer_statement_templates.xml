                            width: 100%;
                            margin: 0 0 4px 0;
                            padding: 0;
                            font-size: 5.5pt !important;
                            line-height: 1.0;
                        ">

                        <div class="col-3"
                             style="
                                padding-left: 1px;
                                padding-right: 1px;
                                font-size: 5.5pt !important;
                            ">

                            <strong style="font-size: 5.5pt !important;">
                                Partner Name:
                            </strong>

                            <span style="font-size: 5.5pt !important;"
                                  t-esc="stmt_data['partner'].name"/>

                        </div>


                        <div class="col-3"
                             style="
                                padding-left: 1px;
                                padding-right: 1px;
                                font-size: 5.5pt !important;
                            ">

                            <strong style="font-size: 5.5pt !important;">
                                Initial Balance:
                            </strong>

                            <span style="font-size: 5.5pt !important;">

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['opening_balance']
                                )"/>

                            </span>

                            <span style="font-size: 5.5pt !important;">
                                IQD
