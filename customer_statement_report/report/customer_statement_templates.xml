<template id="from_lines">

    <t t-call="web.html_container">

        <style>

            /* =========================================================
               PAGE
               ========================================================= */

            .page {
                font-size: 7px;
                line-height: 1.05;
            }

            .statement-title {
                font-size: 13px;
                margin: 0 0 5px 0;
            }

            .statement-info {
                font-size: 6.5px;
                line-height: 1.05;
                margin-bottom: 5px;
            }

            .statement-info .col-3 {
                padding-left: 2px;
                padding-right: 2px;
            }


            /* =========================================================
               MAIN TABLE
               ========================================================= */

            .statement-table {
                width: 100% !important;
                table-layout: fixed !important;
                border-collapse: collapse !important;
                font-size: 6px !important;
                line-height: 1.0 !important;
                margin-bottom: 5px;
            }


            /* =========================================================
               COLUMN WIDTHS
               مجموعها = 100%
               ========================================================= */

            .statement-table col.col-date {
                width: 7%;
            }

            .statement-table col.col-trans {
                width: 13%;
            }

            .statement-table col.col-desc {
                width: 27%;
            }

            .statement-table col.col-qty {
                width: 8%;
            }

            .statement-table col.col-price {
                width: 11%;
            }

            .statement-table col.col-debit {
                width: 11%;
            }

            .statement-table col.col-credit {
                width: 11%;
            }

            .statement-table col.col-balance {
                width: 12%;
            }


            /* =========================================================
               TABLE CELLS
               ========================================================= */

            .statement-table th,
            .statement-table td {
                padding: 1px 2px !important;
                margin: 0 !important;
                vertical-align: middle !important;

                font-size: 6px !important;
                line-height: 1.0 !important;

                overflow: hidden !important;

                word-break: break-word !important;
                overflow-wrap: anywhere !important;

                white-space: normal !important;
            }


            /* =========================================================
               TABLE HEADER
               ========================================================= */

            .statement-table thead th {
                font-size: 6px !important;
                font-weight: bold !important;

                white-space: normal !important;

                word-break: break-word !important;
                overflow-wrap: anywhere !important;

                padding: 1px 2px !important;
            }


            /* =========================================================
               NUMERIC CELLS
               ========================================================= */

            .statement-table td.text-end,
            .statement-table th.text-end {

                text-align: right !important;

                font-size: 5.5px !important;
                line-height: 1.0 !important;

                white-space: normal !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;
            }


            /* =========================================================
               BALANCE
               ========================================================= */

            .statement-table td:last-child,
            .statement-table th:last-child {

                font-size: 5.5px !important;

                text-align: right !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;

                white-space: normal !important;
            }


            /* =========================================================
               TRANSACTION COLUMN
               ========================================================= */

            .statement-table td:nth-child(2) {

                font-size: 5.5px !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;

                white-space: normal !important;
            }


            /* =========================================================
               PRODUCT / DESCRIPTION
               ========================================================= */

            .statement-table td:nth-child(3) {

                font-size: 5.8px !important;

                word-break: break-word !important;
                overflow-wrap: anywhere !important;

                white-space: normal !important;
            }


            /* =========================================================
               DATE
               ========================================================= */

            .statement-table td:first-child {

                font-size: 5.5px !important;

                word-break: break-word !important;
                overflow-wrap: anywhere !important;
            }


            /* =========================================================
               STRONG INSIDE BALANCE
               ========================================================= */

            .statement-table td strong {

                font-size: 5.5px !important;
                font-weight: bold !important;
            }


            /* =========================================================
               TOTAL
               ========================================================= */

            .statement-total {

                width: 100% !important;

                font-size: 6px !important;

                margin-top: 3px;
                margin-bottom: 6px;

                page-break-inside: avoid;
            }

            .statement-total table {

                width: 100% !important;

                table-layout: fixed !important;

                border-collapse: collapse !important;
            }

            .statement-total th,
            .statement-total td {

                padding: 2px !important;

                font-size: 6px !important;

                line-height: 1.0 !important;

                font-weight: bold !important;

                word-break: break-all !important;
                overflow-wrap: anywhere !important;
            }


            /* =========================================================
               FINAL BALANCE
               ========================================================= */

            .statement-balance {

                font-size: 6.5px !important;

                line-height: 1.0 !important;

                margin-top: 5px;

                page-break-inside: avoid;
            }

            .statement-balance span {

                font-size: 6.5px !important;
            }


            /* =========================================================
               SIGNATURE
               ========================================================= */

            .statement-signature {

                font-size: 6.5px !important;

                line-height: 1.0 !important;

                margin-top: 8px;

                page-break-inside: avoid;
            }

            .statement-signature .col-6 {

                padding-left: 3px;
                padding-right: 3px;
            }


            /* =========================================================
               FORCE QWEB / WKHTMLTOPDF
               ========================================================= */

            table {

                max-width: 100% !important;

                box-sizing: border-box !important;
            }

            th,
            td {

                box-sizing: border-box !important;
            }

        </style>


        <t t-foreach="statements" t-as="stmt_data">

            <t t-call="web.external_layout">

                <div class="page">


                    <!-- =================================================
                         TITLE
                         ================================================= -->

                    <h2 class="text-center statement-title">

                        Customer Statement Report

                    </h2>


                    <!-- =================================================
                         STATEMENT INFORMATION
                         ================================================= -->

                    <div class="row statement-info">

                        <div class="col-3">

                            <strong>Partner Name:</strong>

                            <span t-esc="stmt_data['partner'].name"/>

                        </div>


                        <div class="col-3">

                            <strong>Initial Balance:</strong>

                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['opening_balance']
                                )"/>

                            </span>

                            IQD

                        </div>


                        <div class="col-3">

                            <strong>From:</strong>

                            <span t-esc="date_from"/>

                        </div>


                        <div class="col-3">

                            <strong>To:</strong>

                            <span t-esc="date_to"/>

                        </div>

                    </div>


                    <!-- =================================================
                         MAIN STATEMENT TABLE
                         ================================================= -->

                    <table class="table table-sm table-bordered statement-table">

                        <!-- =================================================
                             IMPORTANT:
                             Fixed column widths
                             ================================================= -->

                        <colgroup>

                            <col class="col-date"/>

                            <col class="col-trans"/>

                            <col class="col-desc"/>

                            <col class="col-qty"/>

                            <col class="col-price"/>

                            <col class="col-debit"/>

                            <col class="col-credit"/>

                            <col class="col-balance"/>

                        </colgroup>


                        <thead>

                            <tr>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Transaction
                                </th>

                                <th>
                                    Product / Description
                                </th>

                                <th class="text-end">
                                    Quantity
                                </th>

                                <th class="text-end">
                                    Unit Price
                                </th>

                                <th class="text-end">
                                    Debit
                                </th>

                                <th class="text-end">
                                    Credit
                                </th>

                                <th class="text-end">
                                    Balance
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t t-foreach="stmt_data['lines']" t-as="line">

                                <tr>


                                    <!-- DATE -->

                                    <td>

                                        <span t-esc="line['date']"/>

                                    </td>


                                    <!-- TRANSACTION -->

                                    <td>

                                        <span t-esc="line['transaction']"/>

                                    </td>


                                    <!-- PRODUCT -->

                                    <td style="white-space: normal !important;">

                                        <span t-esc="line['product']"/>

                                    </td>


                                    <!-- QUANTITY -->

                                    <td class="text-end">

                                        <t t-if="line['quantity'] is not None">

                                            <span>

                                                <t t-esc="'{:,.3f}'.format(
                                                    line['quantity']
                                                )"/>

                                            </span>

                                        </t>

                                    </td>


                                    <!-- UNIT PRICE -->

                                    <td class="text-end">

                                        <t t-if="line['unit_price'] is not None">

                                            <span>

                                                <t t-esc="'{:,.2f}'.format(
                                                    line['unit_price']
                                                )"/>

                                            </span>

                                        </t>

                                    </td>


                                    <!-- DEBIT -->

                                    <td class="text-end">

                                        <span>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['debit']
                                            )"/>

                                        </span>

                                    </td>


                                    <!-- CREDIT -->

                                    <td class="text-end">

                                        <span>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['credit']
                                            )"/>

                                        </span>

                                    </td>


                                    <!-- BALANCE -->

                                    <td class="text-end">

                                        <strong>

                                            <t t-esc="'{:,.2f}'.format(
                                                line['balance']
                                            )"/>

                                        </strong>

                                    </td>


                                </tr>

                            </t>

                        </tbody>

                    </table>


                    <!-- =================================================
                         TOTAL
                         ================================================= -->

                    <div class="statement-total">

                        <table class="table table-sm table-bordered">

                            <tr>

                                <th colspan="3">
                                    Total
                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.3f}'.format(
                                        stmt_data['total_qty']
                                    )"/>

                                </th>


                                <th>
                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_debit']
                                    )"/>

                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['total_credit']
                                    )"/>

                                </th>


                                <th class="text-end">

                                    <t t-esc="'{:,.2f}'.format(
                                        stmt_data['closing_balance']
                                    )"/>

                                </th>

                            </tr>

                        </table>

                    </div>


                    <!-- =================================================
                         FINAL BALANCE
                         ================================================= -->

                    <div class="row statement-balance">

                        <div class="col-6">

                            <strong>
                                Current Balance:
                            </strong>

                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>

                            </span>

                            IQD

                        </div>


                        <div class="col-6">

                            <strong>
                                Final Account Balance:
                            </strong>

                            <span>

                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['closing_balance']
                                )"/>

                            </span>

                            IQD

                        </div>

                    </div>


                    <!-- =================================================
                         SIGNATURE
                         ================================================= -->

                    <div class="row statement-signature">

                        <div class="col-6">

                            <strong>
                                Accountant Name:
                            </strong>

                            ______________________________

                        </div>


                        <div class="col-6">

                            <strong>
                                Accountant Signature:
                            </strong>

                            ______________________________

                        </div>

                    </div>


                </div>


            </t>


            <!-- =================================================
                 PAGE BREAK BETWEEN STATEMENTS
                 ================================================= -->

            <t t-if="not stmt_data_last">

                <div style="page-break-after: always;"></div>

            </t>


        </t>


    </t>

</template>




    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Customer Statement Report (Balance)</h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="wizard.partner_id.name"/>
                        </div>
                        <div class="col-3">
                            <strong>Initial Balance:</strong>
                            <span t-esc="'%.2f' % stmt['opening_balance']"/> IQD
                        </div>
                        <div class="col-3">
                            <strong>From:</strong>
                            <span t-esc="wizard.date_from"/>
                        </div>
                        <div class="col-3">
                            <strong>To:</strong>
                            <span t-esc="wizard.date_to"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="stmt['lines']" t-as="line">
                                <td t-esc="line['date']"/>
                                <td t-esc="line['transaction']"/>
                                <td t-esc="line['product']"/>
                                <td t-esc="line['quantity']"/>
                                <td t-esc="'%.2f' % line['unit_price']"/>
                                <td t-esc="'%.2f' % line['debit']"/>
                                <td t-esc="'%.2f' % line['credit']"/>
                                <td t-esc="'%.2f' % line['balance']"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="text-end mt-3">
                        <strong>Closing Balance: </strong>
                        <span t-esc="'%.2f' % stmt['closing_balance']"/> IQD
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>