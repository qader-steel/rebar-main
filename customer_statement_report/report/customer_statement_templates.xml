<template id="from_lines">

    <t t-call="web.html_container">

        <t t-foreach="statements" t-as="stmt_data">

            <t t-call="web.external_layout">

                <div class="page">

                    <!-- ================================================= -->
                    <!-- Header -->
                    <!-- ================================================= -->

                    <h2 class="text-center">
                        Customer Statement Report
                    </h2>

                    <div class="row mt-3 mb-3">

                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="stmt_data['partner'].name"/>
                        </div>

                        <div class="col-3">
                            <strong>Initial Balance:</strong>

                            <span>
                                <t t-esc="'{:,.2f}'.format(
                                    stmt_data['opening_balance']
                                )"/>
                            </span>

                            IQD
                        </div>

                        <div class="col-3">
                            <strong>From:</strong>

                            <span t-esc="date_from"/>
                        </div>

                        <div class="col-3">
                            <strong>To:</strong>

                            <span t-esc="date_to"/>
                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- Statement Table -->
                    <!-- ================================================= -->

                    <table class="table table-sm table-bordered">

                        <thead>

                            <tr>

                                <th>Date</th>

                                <th>Transaction</th>

                                <th>
                                    Product / Description
                                </th>

                                <th>
                                    Quantity
                                </th>

                                <th>
                                    Unit Price
                                </th>

                                <th>
                                    Debit
                                </th>

                                <th>
                                    Credit
                                </th>

                                <th>
                                    Balance
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t
                                t-foreach="stmt_data['lines']"
                                t-as="line"
                            >

                                <tr>

                                    <!-- Date -->

                                    <td>
                                        <span
                                            t-esc="line['date']"
                                        />
                                    </td>


                                    <!-- Transaction -->

                                    <td>
                                        <span
                                            t-esc="line['transaction']"
                                        />
                                    </td>


                                    <!-- Description -->

                                    <td
                                        style="white-space: pre-line;"
                                    >
                                        <span
                                            t-esc="line['product']"
                                        />
                                    </td>


                                    <!-- Quantity -->

                                    <td class="text-end">

                                        <t
                                            t-if="line['quantity'] is not None"
                                        >

                                            <span>
                                                <t
                                                    t-esc="'{:,.3f}'.format(
                                                        line['quantity']
                                                    )"
                                                />
                                            </span>

                                        </t>

                                    </td>


                                    <!-- Unit Price -->

                                    <td class="text-end">

                                        <t
                                            t-if="line['unit_price'] is not None"
                                        >

                                            <span>
                                                <t
                                                    t-esc="'{:,.2f}'.format(
                                                        line['unit_price']
                                                    )"
                                                />
                                            </span>

                                        </t>

                                    </td>


                                    <!-- Debit -->

                                    <td class="text-end">

                                        <t
                                            t-esc="'{:,.2f}'.format(
                                                line['debit']
                                            )"
                                        />

                                    </td>


                                    <!-- Credit -->

                                    <td class="text-end">

                                        <t
                                            t-esc="'{:,.2f}'.format(
                                                line['credit']
                                            )"
                                        />

                                    </td>


                                    <!-- Balance -->

                                    <td class="text-end">

                                        <strong>

                                            <t
                                                t-esc="'{:,.2f}'.format(
                                                    line['balance']
                                                )"
                                            />

                                        </strong>

                                    </td>

                                </tr>

                            </t>

                        </tbody>


                        <!-- ================================================= -->
                        <!-- Totals -->
                        <!-- ================================================= -->

                        <tfoot>

                            <tr>

                                <th colspan="3">
                                    Total
                                </th>


                                <th class="text-end">

                                    <t
                                        t-esc="'{:,.3f}'.format(
                                            stmt_data['total_qty']
                                        )"
                                    />

                                </th>


                                <th></th>


                                <th class="text-end">

                                    <t
                                        t-esc="'{:,.2f}'.format(
                                            stmt_data['total_debit']
                                        )"
                                    />

                                </th>


                                <th class="text-end">

                                    <t
                                        t-esc="'{:,.2f}'.format(
                                            stmt_data['total_credit']
                                        )"
                                    />

                                </th>


                                <th class="text-end">

                                    <t
                                        t-esc="'{:,.2f}'.format(
                                            stmt_data['closing_balance']
                                        )"
                                    />

                                </th>

                            </tr>

                        </tfoot>

                    </table>


                    <!-- ================================================= -->
                    <!-- Balance Summary -->
                    <!-- ================================================= -->

                    <div class="row mt-3">

                        <div class="col-6">

                            <strong>
                                Current Balance:
                            </strong>

                            <span>

                                <t
                                    t-esc="'{:,.2f}'.format(
                                        stmt_data['closing_balance']
                                    )"
                                />

                            </span>

                            IQD

                        </div>


                        <div class="col-6">

                            <strong>
                                Final Account Balance:
                            </strong>

                            <span>

                                <t
                                    t-esc="'{:,.2f}'.format(
                                        stmt_data['closing_balance']
                                    )"
                                />

                            </span>

                            IQD

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- Accountant -->
                    <!-- ================================================= -->

                    <div class="row mt-4">

                        <div class="col-6">

                            <strong>
                                Accountant Name:
                            </strong>

                            __________________________

                        </div>


                        <div class="col-6">

                            <strong>
                                Accountant Signature:
                            </strong>

                            __________________________

                        </div>

                    </div>

                </div>

            </t>


            <t t-if="not stmt_data_last">

                <div
                    style="page-break-after: always;"
                />

            </t>

        </t>

    </t>

</template>






    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Customer Statement Report (Balance)</h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-3">
                            <strong>Partner Name:</strong>
                            <span t-esc="wizard.partner_id.name"/>
                        </div>
                        <div class="col-3">
                            <strong>Initial Balance:</strong>
                            <span t-esc="'%.2f' % stmt['opening_balance']"/> IQD
                        </div>
                        <div class="col-3">
                            <strong>From:</strong>
                            <span t-esc="wizard.date_from"/>
                        </div>
                        <div class="col-3">
                            <strong>To:</strong>
                            <span t-esc="wizard.date_to"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Transaction</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="stmt['lines']" t-as="line">
                                <td t-esc="line['date']"/>
                                <td t-esc="line['transaction']"/>
                                <td t-esc="line['product']"/>
                                <td t-esc="line['quantity']"/>
                                <td t-esc="'%.2f' % line['unit_price']"/>
                                <td t-esc="'%.2f' % line['debit']"/>
                                <td t-esc="'%.2f' % line['credit']"/>
                                <td t-esc="'%.2f' % line['balance']"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="text-end mt-3">
                        <strong>Closing Balance: </strong>
                        <span t-esc="'%.2f' % stmt['closing_balance']"/> IQD
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>