<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_automation" model="ir.ui.view">
        <field name="name">sale.order.form.automation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_run_full_cycle"
                        string="تنفيذ الدورة الكاملة"
                        type="object"
                        class="oe_highlight"
                        confirm="سيتم احتساب Net Weight أولًا، ثم تأكيد البيع ومعالجة الشراء والمخزون وإنشاء وترحيل الفواتير. هل تريد المتابعة؟"
                        invisible="state in ('cancel',)"/>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
                <field name="x_studio_po_price" optional="show"/>
            </xpath>

            <!-- Management requested the dropshipping smart-button value/name
                 to be the fixed value 'هلال بابل'. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_qss_dropship"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="state == 'cancel'">
                    <div class="o_stat_info">
                        <field name="qss_dropship_label" class="o_stat_value"/>
                        <span class="o_stat_text">Dropshipping</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
