<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 report templates use explicit th/td names. Keep these xpaths
         strict so module installation fails only on real structural changes. -->

    <!-- Hide Taxes in Sale Order / Quotation -->
    <template id="report_saleorder_document_no_taxes" inherit_id="sale.report_saleorder_document">
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@name='total']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
    </template>

    <!-- Hide Taxes in Invoice -->
    <template id="report_invoice_document_no_taxes" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
    </template>

    <!-- Hide Taxes in Purchase Order. In Odoo 19 the product tax cell does not
         have a name, so locate it through its tax-label rendering expression. -->
    <template id="report_purchaseorder_document_no_taxes" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[span[contains(@t-out, 'tax.tax_label')]]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
    </template>
</odoo>
