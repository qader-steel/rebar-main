<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_mq_bundle" inherit_id="stock.report_delivery_document">
        <!-- Add Sequence Header at the beginning of move table -->
        <xpath expr="//th[@name='th_sm_product']" position="before">
            <th name="th_sm_seq" class="text-center" style="width: 35px;">#</th>
        </xpath>

        <!-- Add Sequence Data at the beginning of move table -->
        <xpath expr="//span[@t-field='move.product_id']/.." position="before">
            <td name="td_sm_seq" class="text-center">
                <span t-esc="move_index + 1"/>
            </td>
        </xpath>

        <!-- Add Bundle Qty Header to move table -->
        <xpath expr="//th[@name='th_sm_ordered']" position="before">
            <th name="th_mq_bundle_qty" class="text-end"><t t-esc="'حزم' if (o.env.context.get('lang') or '').startswith('ar') else 'Bundle Qty'"/></th>
        </xpath>

        <!-- Add Bundle Qty Data to move table -->
        <xpath expr="//span[@t-out='format_number(move.product_uom_qty)']/.." position="before">
            <td name="td_mq_bundle_qty" class="text-end">
                <span t-field="move.mq_bundle_qty"/>
            </td>
        </xpath>

        <!-- Add Sequence Header at the beginning of aggregated table -->
        <xpath expr="//th[@name='th_sml_product']" position="before">
            <th name="th_sml_seq" class="text-center" style="width: 35px;">#</th>
        </xpath>

        <!-- Totals injected before 'informations' — loads after driver info so sits directly below it -->
        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="o.mq_scale_net_weight > 0 or o.mq_total_bundle_qty > 0" class="row mb-4">
                <div class="col-12">
                    <div class="row" style="margin: 0; padding: 10px 16px; background-color: #eef2f7; border-radius: 8px;">
                        <div t-if="o.mq_scale_net_weight > 0" class="col text-center">
                            <div style="font-weight: 600; font-size: 0.8em; color: #555; text-transform: uppercase; letter-spacing: 0.03em;"><t t-esc="'Scale Net Weight' if (o.env.context.get('lang') or '').startswith('ar') else 'Scale Net Weight'"/></div>
                            <div style="font-size: 1.05em; font-weight: 700;" t-field="o.mq_scale_net_weight"/>
                        </div>
                        <div t-if="o.mq_total_bundle_qty > 0" class="col text-center">
                            <div style="font-weight: 600; font-size: 0.8em; color: #555; text-transform: uppercase; letter-spacing: 0.03em;"><t t-esc="'إجمالي الحزم' if (o.env.context.get('lang') or '').startswith('ar') else 'Total Bundle Qty'"/></div>
                            <div style="font-size: 1.05em; font-weight: 700;" t-field="o.mq_total_bundle_qty"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Add Bundle Qty Header to aggregated table -->
        <xpath expr="//th[@name='th_sml_qty_ordered']" position="before">
            <th name="th_sml_mq_bundle_qty" class="text-end"><t t-esc="'حزم' if (o.env.context.get('lang') or '').startswith('ar') else 'Bundle Qty'"/></th>
        </xpath>
    </template>

    <!-- DONE STATE: Add Sequence and Bundle Qty Data (Aggregated - No Serial) -->
    <template id="report_delivery_aggregated_mq_bundle" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <!-- Add Sequence Data -->
        <xpath expr="//span[@t-out=&quot;aggregated_lines[line]['name']&quot;]/.." position="before">
            <td class="text-center">
                <span t-esc="line_index + 1"/>
            </td>
        </xpath>
        <!-- Add Bundle Qty Data -->
        <xpath expr="//td[@name='move_line_aggregated_qty_ordered']" position="before">
            <td name="td_sml_mq_bundle_qty" class="text-end">
                <span t-if="aggregated_lines[line].get('move')" t-out="aggregated_lines[line]['move'].mq_bundle_qty"/>
            </td>
        </xpath>
    </template>

    <!-- DONE STATE: Add Sequence and Bundle Qty Data (With Serial) -->
    <template id="report_delivery_has_serial_mq_bundle" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <!-- Add Sequence Data -->
        <xpath expr="//span[@t-field='move_line.product_id']/.." position="before">
            <td class="text-center">
                <span t-esc="move_line_index + 1"/>
            </td>
        </xpath>
        <!-- Add Bundle Qty Data -->
        <xpath expr="//t[@name='move_line_lot']" position="before">
            <td name="td_sml_mq_bundle_qty" class="text-end">
                <span t-field="move_line.move_id.mq_bundle_qty"/>
            </td>
        </xpath>
    </template>
</odoo>
