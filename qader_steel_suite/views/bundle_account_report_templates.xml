<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_mq_bundle" inherit_id="account.report_invoice_document">
        <!-- Hide taxes and discount column natively -->
        <xpath expr="//t[@t-set='display_taxes']" position="after">
            <t t-set="display_taxes" t-value="False"/>
            <t t-set="display_discount" t-value="False"/>
        </xpath>

        <!-- Add Sequence Header -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_seq" class="text-center" style="width: 35px;">#</th>
        </xpath>

        <!-- Add Sequence Data at the beginning -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="td_seq" class="text-center">
                <!-- Only show sequence for product lines, not sections or notes -->
                <t t-if="not line.display_type">
                    <span t-esc="line_index + 1"/>
                </t>
            </td>
        </xpath>

        <!-- Add Bundle Qty Header -->
        <xpath expr="//th[@name='th_quantity']" position="before">
            <th name="th_mq_bundle_qty" class="text-end"><t t-esc="'حزم' if (o.env.context.get('lang') or '').startswith('ar') else 'Bundle Qty'"/></th>
        </xpath>

        <!-- Add Bundle Qty Data -->
        <xpath expr="//span[@t-field='line.quantity']/.." position="before">
            <td name="td_mq_bundle_qty" class="text-end">
                <span t-field="line.mq_bundle_qty"/>
            </td>
        </xpath>

        <!-- Totals injected before 'informations' — loads after driver info so sits directly below it -->
        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="o.mq_total_weight > 0 or o.mq_total_bundle_qty > 0" class="row mb-4">
                <div class="col-12">
                    <div class="row" style="margin: 0; padding: 10px 16px; background-color: #eef2f7; border-radius: 8px;">
                        <div t-if="o.mq_total_weight > 0" class="col text-center">
                            <div style="font-weight: 600; font-size: 0.8em; color: #555; text-transform: uppercase; letter-spacing: 0.03em;"><t t-esc="'Total Weight (Ton)' if (o.env.context.get('lang') or '').startswith('ar') else 'Total Weight (Ton)'"/></div>
                            <div style="font-size: 1.05em; font-weight: 700;" t-field="o.mq_total_weight"/>
                        </div>
                        <div t-if="o.mq_total_bundle_qty > 0" class="col text-center">
                            <div style="font-weight: 600; font-size: 0.8em; color: #555; text-transform: uppercase; letter-spacing: 0.03em;"><t t-esc="'إجمالي الحزم' if (o.env.context.get('lang') or '').startswith('ar') else 'Total Bundle Qty'"/></div>
                            <div style="font-size: 1.05em; font-weight: 700;" t-field="o.mq_total_bundle_qty"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
