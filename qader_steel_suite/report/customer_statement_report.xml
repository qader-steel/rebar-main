<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Landscape, because the "currencies side by side" layout adds four
         columns per currency on top of the four shared ones: two currencies
         already means twelve columns, which A4 portrait cannot hold without
         wrapping every figure onto three lines. The sections layout is
         unaffected by the wider page. -->
    <record id="paperformat_customer_statement" model="report.paperformat">
        <field name="name">Customer Statement (Landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">28</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_customer_statement" model="ir.actions.report">
        <field name="name">Customer Statement</field>
        <field name="model">customer.statement.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">qader_steel_suite.statement</field>
        <field name="report_file">qader_steel_suite.statement</field>
        <field name="print_report_name">'Statement - %s' % (object.partner_id.name or '')</field>
        <field name="paperformat_id" ref="paperformat_customer_statement"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_customer_statement_from_lines" model="ir.actions.report">
        <field name="name">Customer Statement (from Journal Items)</field>
        <field name="model">account.move.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">qader_steel_suite.from_lines</field>
        <field name="report_file">qader_steel_suite.from_lines</field>
        <field name="print_report_name">'Customer Statement'</field>
        <field name="paperformat_id" ref="paperformat_customer_statement"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
