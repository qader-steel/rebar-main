<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         SHARED STATEMENT BODY
         Expects in the rendering context:
             statements      : list of statement dicts (see the engine)
             date_from       : date
             date_to         : date
             currency_filter : res.currency or False
         ================================================================== -->

    <template id="statement_body">

        <t t-foreach="statements" t-as="stmt_data">

            <t t-call="web.external_layout">

                <div class="page"
                     style="width:100%; font-size:8pt; line-height:1.15;
                            box-sizing:border-box;">

                    <!-- ============================================
                         TITLE
                         ============================================ -->

                    <h2 class="text-center"
                        style="font-size:14pt; line-height:1.15;
                               margin:0 0 8px 0; padding:0; font-weight:bold;">
                        <t t-if="stmt_data['party_type'] == 'vendor'">Vendor Statement Report</t>
                        <t t-else="">Customer Statement Report</t>
                    </h2>

                    <!-- ============================================
                         STATEMENT INFORMATION
                         ============================================ -->

                    <div class="row"
                         style="width:100%; margin:0 0 8px 0;
                                font-size:8pt; line-height:1.2;">

                        <div class="col-4"
                             style="padding-left:3px; padding-right:3px;
                                    word-wrap:break-word;">
                            <strong>Partner:</strong>
                            <span t-out="stmt_data['partner'].name"/>
                        </div>

                        <div class="col-2" style="padding-left:3px; padding-right:3px;">
                            <strong>From:</strong>
                            <span t-out="date_from"/>
                        </div>

                        <div class="col-2" style="padding-left:3px; padding-right:3px;">
                            <strong>To:</strong>
                            <span t-out="date_to"/>
                        </div>

                        <div class="col-2" style="padding-left:3px; padding-right:3px;">
                            <strong>Company Currency:</strong>
                            <span t-out="stmt_data['company_currency'].name"/>
                        </div>

                        <div class="col-2" style="padding-left:3px; padding-right:3px;">
                            <strong>Currencies:</strong>
                            <span t-out="', '.join([g['currency'].name for g in stmt_data['currency_groups']])"/>
                        </div>

                    </div>

                    <!-- ============================================
                         BALANCES BY CURRENCY  (summary, at a glance)
                         ================================================
                         The accountant asked to see "the IQD total on its
                         own and the USD total on its own" without having
                         to scroll through every section first. This block
                         is pure presentation: every figure below is read
                         straight from the per-currency groups the engine
                         already computed - nothing is recalculated here,
                         so it can never disagree with the sections below.
                         ============================================ -->

                    <div style="margin:0 0 10px 0; page-break-inside:avoid;">

                        <div style="background-color:#dee2e6; border:1px solid #adb5bd;
                                    padding:3px 5px; font-size:9pt; font-weight:bold;">
                            Balances by Currency / الأرصدة حسب العملة
                        </div>

                        <table class="table table-sm table-bordered"
                               style="width:100%; table-layout:fixed;
                                      border-collapse:collapse; margin:0;">

                            <colgroup>
                                <col style="width:16%;"/>
                                <col style="width:21%;"/>
                                <col style="width:21%;"/>
                                <col style="width:21%;"/>
                                <col style="width:21%;"/>
                            </colgroup>

                            <thead>
                                <tr style="background-color:#f1f3f5;">
                                    <th style="font-size:6.5pt; padding:2px; text-align:center;">
                                        Currency<br/>العملة
                                    </th>
                                    <th style="font-size:6.5pt; padding:2px; text-align:center;">
                                        Opening<br/>رصيد افتتاحي
                                    </th>
                                    <th style="font-size:6.5pt; padding:2px; text-align:center;">
                                        Total Debit<br/>إجمالي مدين
                                    </th>
                                    <th style="font-size:6.5pt; padding:2px; text-align:center;">
                                        Total Credit<br/>إجمالي دائن
                                    </th>
                                    <th style="font-size:6.5pt; padding:2px; text-align:center;">
                                        Closing Balance<br/>الرصيد الختامي
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="stmt_data['currency_groups']" t-as="sgrp">
                                    <t t-set="scur" t-value="sgrp['currency']"/>
                                    <tr>
                                        <td style="font-size:7pt; padding:2px;
                                                   font-weight:bold; text-align:center;">
                                            <span t-out="scur.name"/>
                                            <t t-if="sgrp['is_company_currency']">
                                                <span style="font-weight:normal; color:#6c757d;">
                                                    (company)
                                                </span>
                                            </t>
                                        </td>
                                        <td style="font-size:7pt; padding:2px; text-align:right;">
                                            <span t-out="sgrp['opening_balance']"
                                                  t-options='{"widget": "monetary", "display_currency": scur}'/>
                                        </td>
                                        <td style="font-size:7pt; padding:2px; text-align:right;">
                                            <span t-out="sgrp['total_debit']"
                                                  t-options='{"widget": "monetary", "display_currency": scur}'/>
                                        </td>
                                        <td style="font-size:7pt; padding:2px; text-align:right;">
                                            <span t-out="sgrp['total_credit']"
                                                  t-options='{"widget": "monetary", "display_currency": scur}'/>
                                        </td>
                                        <td style="font-size:7.5pt; padding:2px; text-align:right;
                                                   font-weight:bold;">
                                            <span t-out="sgrp['closing_balance']"
                                                  t-options='{"widget": "monetary", "display_currency": scur}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>

                        </table>

                        <div style="font-size:6.5pt; color:#6c757d; margin-top:2px;">
                            Each currency is kept separate on purpose - balances in
                            different currencies are never added together.
                            كل عملة مستقلة تمامًا؛ لا تُجمع أرصدة عملات مختلفة معًا.
                        </div>

                    </div>

                    <!-- ============================================
                         ONE SECTION PER CURRENCY
                         ============================================ -->

                    <t t-foreach="stmt_data['currency_groups']" t-as="grp">

                        <t t-set="cur" t-value="grp['currency']"/>

                        <div style="margin-top:10px;">

                            <!-- CURRENCY SECTION HEADER -->

                            <div style="background-color:#e9ecef; border:1px solid #adb5bd;
                                        padding:3px 5px; margin-bottom:4px;
                                        font-size:9pt; font-weight:bold;
                                        page-break-after:avoid;">

                                Statement in <span t-out="cur.name"/>

                                <span style="float:right; font-weight:normal;">
                                    <strong>Opening Balance:</strong>
                                    <span t-out="grp['opening_balance']"
                                          t-options='{"widget": "monetary", "display_currency": cur}'/>
                                </span>

                            </div>

                            <!-- ============================================
                                 MAIN TABLE
                                 ============================================ -->

                            <table class="table table-sm table-bordered statement-table"
                                   style="width:100%; table-layout:fixed;
                                          border-collapse:collapse; margin:0;">

                                <colgroup>
                                    <col style="width:8%;"/>
                                    <col style="width:14%;"/>
                                    <col style="width:25%;"/>
                                    <col style="width:8%;"/>
                                    <col style="width:11%;"/>
                                    <col style="width:11%;"/>
                                    <col style="width:11%;"/>
                                    <col style="width:12%;"/>
                                </colgroup>

                                <thead>
                                    <tr>
                                        <th style="font-size:6.5pt; padding:2px; text-align:center;
                                                   line-height:1.05; white-space:normal;">Date</th>
                                        <th style="font-size:6.5pt; padding:2px; text-align:center;
                                                   line-height:1.05; white-space:normal;">Transaction</th>
                                        <th style="font-size:6.5pt; padding:2px; text-align:center;
                                                   line-height:1.05; white-space:normal;">Product / Description</th>
                                        <th style="font-size:6.5pt; padding:2px; text-align:center;
                                                   line-height:1.05; white-space:normal;">Quantity</th>
                                        <th style="font-size:6.5pt; padding:2px; text-align:center;
                                                   line-height:1.05; white-space:normal;">
                                            Unit Price (<span t-out="cur.name"/>)
                                        </th>
                                        <th style="font-size:6.5pt; padding:2px; text-align:center;
                                                   line-height:1.05; white-space:normal;">
                                            Debit (<span t-out="cur.name"/>)
                                        </th>
                                        <th style="font-size:6.5pt; padding:2px; text-align:center;
                                                   line-height:1.05; white-space:normal;">
                                            Credit (<span t-out="cur.name"/>)
                                        </th>
                                        <th style="font-size:6.5pt; padding:2px; text-align:center;
                                                   line-height:1.05; white-space:normal;">
                                            Balance (<span t-out="cur.name"/>)
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <!-- OPENING BALANCE ROW -->

                                    <tr style="background-color:#f8f9fa;">
                                        <td style="font-size:6pt; padding:2px;">
                                            <span t-out="date_from"/>
                                        </td>
                                        <td style="font-size:6pt; padding:2px;"/>
                                        <td style="font-size:6pt; padding:2px; font-style:italic;">
                                            Opening Balance
                                        </td>
                                        <td style="font-size:6pt; padding:2px;"/>
                                        <td style="font-size:6pt; padding:2px;"/>
                                        <td style="font-size:6pt; padding:2px;"/>
                                        <td style="font-size:6pt; padding:2px;"/>
                                        <td style="font-size:6pt; padding:2px; text-align:right;">
                                            <span t-out="grp['opening_balance']"
                                                  t-options='{"widget": "monetary", "display_currency": cur}'/>
                                        </td>
                                    </tr>

                                    <!-- DATA ROWS -->

                                    <t t-foreach="grp['lines']" t-as="line">

                                        <tr>

                                            <td style="font-size:6pt; padding:2px; line-height:1.05;
                                                       vertical-align:middle; word-wrap:break-word;">
                                                <span t-out="line['date']"/>
                                            </td>

                                            <td style="font-size:6pt; padding:2px; line-height:1.05;
                                                       vertical-align:middle; word-wrap:break-word;">
                                                <span t-out="line['transaction']"/>
                                            </td>

                                            <td style="font-size:6pt; padding:2px; line-height:1.05;
                                                       vertical-align:middle; word-wrap:break-word;">
                                                <span t-out="line['product']"/>
                                            </td>

                                            <td style="font-size:6pt; padding:2px; line-height:1.05;
                                                       vertical-align:middle; text-align:right;">
                                                <t t-if="line['quantity']">
                                                    <span t-out="line['quantity']"
                                                          t-options='{"widget": "float", "precision": 2}'/>
                                                </t>
                                            </td>

                                            <td style="font-size:6pt; padding:2px; line-height:1.05;
                                                       vertical-align:middle; text-align:right;">
                                                <t t-if="line['unit_price']">
                                                    <span t-out="line['unit_price']"
                                                          t-options='{"widget": "monetary", "display_currency": cur}'/>
                                                </t>
                                            </td>

                                            <td style="font-size:6pt; padding:2px; line-height:1.05;
                                                       vertical-align:middle; text-align:right;">
                                                <t t-if="line['debit']">
                                                    <span t-out="line['debit']"
                                                          t-options='{"widget": "monetary", "display_currency": cur}'/>
                                                </t>
                                            </td>

                                            <td style="font-size:6pt; padding:2px; line-height:1.05;
                                                       vertical-align:middle; text-align:right;">
                                                <t t-if="line['credit']">
                                                    <span t-out="line['credit']"
                                                          t-options='{"widget": "monetary", "display_currency": cur}'/>
                                                </t>
                                            </td>

                                            <td style="font-size:6pt; padding:2px; line-height:1.05;
                                                       vertical-align:middle; text-align:right;">
                                                <span t-out="line['balance']"
                                                      t-options='{"widget": "monetary", "display_currency": cur}'/>
                                            </td>

                                        </tr>

                                    </t>

                                </tbody>

                                <!-- ============================================
                                     TOTALS FOR THIS CURRENCY
                                     ============================================ -->

                                <tfoot>

                                    <tr style="font-weight:bold; background-color:#e9ecef;
                                               page-break-inside:avoid;">

                                        <td colspan="3"
                                            style="font-size:6.5pt; padding:2px; text-align:right;">
                                            Total (<span t-out="cur.name"/>)
                                        </td>

                                        <td style="font-size:6.5pt; padding:2px; text-align:right;">
                                            <span t-out="grp['total_qty']"
                                                  t-options='{"widget": "float", "precision": 2}'/>
                                        </td>

                                        <td style="font-size:6.5pt; padding:2px;"/>

                                        <td style="font-size:6.5pt; padding:2px; text-align:right;">
                                            <span t-out="grp['total_debit']"
                                                  t-options='{"widget": "monetary", "display_currency": cur}'/>
                                        </td>

                                        <td style="font-size:6.5pt; padding:2px; text-align:right;">
                                            <span t-out="grp['total_credit']"
                                                  t-options='{"widget": "monetary", "display_currency": cur}'/>
                                        </td>

                                        <td style="font-size:6.5pt; padding:2px; text-align:right;">
                                            <span t-out="grp['closing_balance']"
                                                  t-options='{"widget": "monetary", "display_currency": cur}'/>
                                        </td>

                                    </tr>

                                </tfoot>

                            </table>

                            <!-- CLOSING BALANCE LINE FOR THIS CURRENCY -->

                            <div style="margin:4px 0 0 0; font-size:8pt;
                                        page-break-inside:avoid;">

                                <strong>
                                    Closing Balance (<span t-out="cur.name"/>):
                                </strong>

                                <span t-out="grp['closing_balance']"
                                      t-options='{"widget": "monetary", "display_currency": cur}'/>

                                <t t-if="not grp['is_company_currency']">
                                    <span style="color:#6c757d;">
                                        - booked in
                                        <span t-out="stmt_data['company_currency'].name"/>
                                        at the historical rate:
                                        <span t-out="grp['closing_balance_company']"
                                              t-options='{"widget": "monetary",
                                                          "display_currency": stmt_data["company_currency"]}'/>
                                    </span>
                                </t>

                            </div>

                        </div>

                    </t>

                    <!-- ============================================
                         CONSOLIDATED TOTAL (company currency)
                         Only meaningful when more than one currency
                         is present.
                         ============================================ -->

                    <t t-if="stmt_data['is_multi_currency']">

                        <div style="margin-top:12px; padding:5px;
                                    border:1px solid #adb5bd; background-color:#f1f3f5;
                                    font-size:8.5pt; page-break-inside:avoid;">

                            <div style="font-weight:bold; margin-bottom:3px;">
                                Consolidated Total in
                                <span t-out="stmt_data['company_currency'].name"/>
                            </div>

                            <div style="font-size:7pt; color:#6c757d; margin-bottom:4px;">
                                Converted at the exchange rate of each entry date
                                (the amounts already booked in the general ledger),
                                not at today's rate.
                            </div>

                            <div class="row" style="width:100%; margin:0;">

                                <div class="col-3" style="padding:0 3px;">
                                    <strong>Opening:</strong>
                                    <span t-out="stmt_data['opening_balance_company']"
                                          t-options='{"widget": "monetary",
                                                      "display_currency": stmt_data["company_currency"]}'/>
                                </div>

                                <div class="col-3" style="padding:0 3px;">
                                    <strong>Total Debit:</strong>
                                    <span t-out="stmt_data['total_debit_company']"
                                          t-options='{"widget": "monetary",
                                                      "display_currency": stmt_data["company_currency"]}'/>
                                </div>

                                <div class="col-3" style="padding:0 3px;">
                                    <strong>Total Credit:</strong>
                                    <span t-out="stmt_data['total_credit_company']"
                                          t-options='{"widget": "monetary",
                                                      "display_currency": stmt_data["company_currency"]}'/>
                                </div>

                                <div class="col-3" style="padding:0 3px;">
                                    <strong>Closing:</strong>
                                    <span t-out="stmt_data['closing_balance_company']"
                                          t-options='{"widget": "monetary",
                                                      "display_currency": stmt_data["company_currency"]}'/>
                                </div>

                            </div>

                        </div>

                    </t>

                    <!-- ============================================
                         SIGNATURE
                         ============================================ -->

                    <div class="row"
                         style="width:100%; margin-top:14px; font-size:8pt;
                                line-height:1.2; page-break-inside:avoid;">

                        <div class="col-6" style="padding-left:3px; padding-right:3px;">
                            <strong>Accountant Name:</strong>
                            __________________________
                        </div>

                        <div class="col-6" style="padding-left:3px; padding-right:3px;">
                            <strong>Accountant Signature:</strong>
                            __________________________
                        </div>

                    </div>

                </div>

            </t>

            <t t-if="not stmt_data_last">
                <div style="page-break-after:always;"/>
            </t>

        </t>

    </template>


    <!-- ==================================================================
         REPORT ENTRY POINTS
         ================================================================== -->

    <template id="from_lines">
        <t t-call="web.html_container">
            <t t-call="qader_steel_suite.statement_body"/>
        </t>
    </template>

    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="qader_steel_suite.statement_body"/>
        </t>
    </template>

</odoo>